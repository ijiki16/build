From: tumredsun <tumredsun@localhost>
Date: Wed, 21 Oct 2026 06:02:02 +0000
Subject: [PATCH 11/28] dt-bindings: net: add Allwinner A733 GMAC-210

---
 .../net/allwinner,sun60i-a733-gmac.yaml       | 140 ++++++++++++++++++
 .../devicetree/bindings/net/snps,dwmac.yaml   |   1 +
 2 files changed, 141 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/allwinner,sun60i-a733-gmac.yaml

diff --git a/Documentation/devicetree/bindings/net/allwinner,sun60i-a733-gmac.yaml b/Documentation/devicetree/bindings/net/allwinner,sun60i-a733-gmac.yaml
new file mode 100644
index 000000000..3bee4c176
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/allwinner,sun60i-a733-gmac.yaml
@@ -0,0 +1,140 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/allwinner,sun60i-a733-gmac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 GMAC-210 Ethernet Controller
+
+maintainers:
+  - tumredsun <tumredsun@localhost>
+
+description: >
+  The Allwinner A733 has two GMAC-210 (DesignWare 5.20 based) ethernet
+  controller units. All the glue configuration registers live in a
+  dedicated block mapped right behind each controller.
+
+properties:
+  compatible:
+    items:
+      - const: allwinner,sun60i-a733-gmac0
+
+  reg:
+    items:
+      - description: MAC control registers
+      - description: Glue registers
+
+  interrupts:
+    minItems: 4
+    items:
+      - description: MAC interrupt
+      - description: Ethernet LPI interrupt
+      - description: TX channel 0 interrupt
+      - description: RX channel 0 interrupt
+
+  interrupt-names:
+    items:
+      - const: macirq
+      - const: eth_lpi
+      - const: tx-queue-0
+      - const: rx-queue-0
+
+  clocks:
+    maxItems: 4
+
+  clock-names:
+    items:
+      - const: stmmaceth
+      - const: mbus
+      - const: phy
+      - const: ptp_ref
+
+  resets:
+    maxItems: 2
+
+  reset-names:
+    items:
+      - const: stmmaceth
+      - const: ahb
+
+  phy-mode: true
+
+  tx-delay:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 63
+    description: >
+      RGMII TX clock delay chain value, in taps. The value is a raw
+      configuration of the delay chain, same as the BSP "tx-delay"
+      property.
+
+  rx-delay:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 31
+    description: >
+      RGMII RX clock delay chain value, in taps. The value is a raw
+      configuration of the delay chain, same as the BSP "rx-delay"
+      property.
+
+  phy-supply:
+    description: Phandle to the regulator feeding the PHY.
+
+  assigned-clocks:
+    maxItems: 1
+
+  assigned-clock-rates:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+
+unevaluatedProperties: false
+
+allOf:
+  - $ref: /schemas/net/ethernet-controller.yaml#
+  - $ref: /schemas/net/snps,dwmac.yaml#
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/sun60i-a733-ccu.h>
+    #include <dt-bindings/reset/sun60i-a733-ccu.h>
+
+    gmac0: ethernet@4500000 {
+        compatible = "allwinner,sun60i-a733-gmac0";
+        reg = <0x4500000 0x8000>,
+              <0x4508000 0x1000>;
+        interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "macirq", "eth_lpi",
+                          "tx-queue-0", "rx-queue-0";
+        clocks = <&ccu CLK_GMAC0>,
+                 <&ccu CLK_GMAC0_MBUS>,
+                 <&ccu CLK_GMAC0_PHY>,
+                 <&ccu CLK_GMAC_PTP>;
+        clock-names = "stmmaceth", "mbus", "phy", "ptp_ref";
+        resets = <&ccu RST_BUS_GMAC0>,
+                 <&ccu RST_BUS_GMAC0_AXI>;
+        reset-names = "stmmaceth", "ahb";
+        assigned-clocks = <&ccu CLK_GMAC0_PHY>;
+        assigned-clock-rates = <25000000>;
+        phy-mode = "rgmii";
+        tx-delay = <12>;
+        rx-delay = <10>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&rgmii0_pins>;
+        status = "disabled";
+
+        mdio0: mdio {
+            compatible = "snps,dwmac-mdio";
+            #address-cells = <1>;
+            #size-cells = <0>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/net/snps,dwmac.yaml b/Documentation/devicetree/bindings/net/snps,dwmac.yaml
