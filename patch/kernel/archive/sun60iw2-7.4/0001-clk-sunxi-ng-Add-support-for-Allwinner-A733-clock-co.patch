new file mode 100644
index 000000000..a29c155cd
--- /dev/null
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733-cpupll.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 Allwinner Technology Co.,Ltd
+ * Copyright (c) 2025 Orange Pi 4 Pro mainline bring-up
+ *
+ * Ported from the Allwinner sun60iw2 BSP CPU PLL driver.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include <dt-bindings/clock/sun60i-a733-cpupll-ccu.h>
+
+#include "ccu_common.h"
+
+#include "ccu_div.h"
+#include "ccu_gate.h"
+#include "ccu_mp.h"
+#include "ccu_mult.h"
+#include "ccu_mux.h"
+#include "ccu_nk.h"
+#include "ccu_nm.h"
+
+#define SUN60I_A733_PLL_CPU_BACK_REG	0x0000
+#define SUN60I_A733_PLL_CPU_L_REG	0x1000
+#define SUN60I_A733_PLL_CPU_B_REG	0x2000
+#define SUN60I_A733_PLL_CPU_DSU_REG	0x3000
+
+#define SUN60I_A733_PLL_CPU_BACK_PAT0_REG	0x0008
+#define SUN60I_A733_PLL_CPU_L_PAT0_REG		0x1004
+#define SUN60I_A733_PLL_CPU_B_PAT0_REG		0x2004
+#define SUN60I_A733_PLL_CPU_DSU_PAT0_REG	0x3004
+
+#define SUN60I_A733_PLL_CPU_BACK_PAT1_REG	0x000c
+#define SUN60I_A733_PLL_CPU_L_PAT1_REG		0x1008
+#define SUN60I_A733_PLL_CPU_B_PAT1_REG		0x2008
+#define SUN60I_A733_PLL_CPU_DSU_PAT1_REG	0x3008
+
+#define SUN60I_A733_PLL_CPU_L_LFM_REG	0x1018
+#define SUN60I_A733_PLL_CPU_B_LFM_REG	0x2018
+#define SUN60I_A733_PLL_CPU_DSU_LFM_REG	0x3018
+
+#define SUN60I_A733_CPU_L_REG		0x101c
+#define SUN60I_A733_CPU_B_REG		0x201c
+#define SUN60I_A733_CPU_DSU_REG		0x301c
+
+/* The P factor of the CPU PLLs lives in the CPU mux registers. */
+
+static struct ccu_mult pll_cpu_back_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.mult		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 0, 53, 105),
+	.common		= {
+		.reg		= 0x0000,
+		.hw.init	= CLK_HW_INIT("pll-cpu-back", "hosc",
+					&ccu_mult_ops,
+					CLK_GET_RATE_NOCACHE |
+					CLK_IS_CRITICAL |
+					CLK_SET_RATE_UNGATE),
+	},
+};
+
+static struct ccu_mult pll_cpu_l_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.mult		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 0, 28, 94),
+	.common		= {
+		.reg		= 0x1000,
+		.hw.init	= CLK_HW_INIT("pll-cpu-l", "hosc",
+					&ccu_mult_ops,
+					CLK_GET_RATE_NOCACHE |
+					CLK_IS_CRITICAL |
+					CLK_SET_RATE_UNGATE),
+	},
+};
+
+static struct ccu_mult pll_cpu_b_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.mult		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 0, 28, 94),
+	.common		= {
+		.reg		= 0x2000,
+		.hw.init	= CLK_HW_INIT("pll-cpu-b", "hosc",
+					&ccu_mult_ops,
+					CLK_GET_RATE_NOCACHE |
+					CLK_IS_CRITICAL |
+					CLK_SET_RATE_UNGATE),
+	},
+};
+
+static struct ccu_mult pll_cpu_dsu_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.mult		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 0, 28, 94),
+	.common		= {
+		.reg		= 0x3000,
+		.hw.init	= CLK_HW_INIT("pll-cpu-dsu", "hosc",
+					&ccu_mult_ops,
+					CLK_GET_RATE_NOCACHE |
+					CLK_IS_CRITICAL |
+					CLK_SET_RATE_UNGATE),
+	},
+};
+
+static const struct clk_parent_data cpu_l_parents[] = {
+	{ .fw_name = "hosc" },
+	{ .hw = &pll_cpu_l_clk.common.hw },
+	{ .name = "pll-peri0-2x" },
+	{ .hw = &pll_cpu_back_clk.common.hw },
+};
+
+static const struct clk_parent_data cpu_b_parents[] = {
+	{ .fw_name = "hosc" },
+	{ .hw = &pll_cpu_b_clk.common.hw },
+	{ .name = "pll-peri0-2x" },
+	{ .hw = &pll_cpu_back_clk.common.hw },
+};
+
+static const struct clk_parent_data cpu_dsu_parents[] = {
+	{ .fw_name = "hosc" },
+	{ .hw = &pll_cpu_dsu_clk.common.hw },
+	{ .name = "pll-peri0-2x" },
+	{ .hw = &pll_cpu_back_clk.common.hw },
+};
+
+static SUNXI_CCU_MUX_DATA(cpu_l_clk, "cpu-l", cpu_l_parents,
+			  0x101c, 24, 3, CLK_SET_RATE_PARENT | CLK_IS_CRITICAL);
+static SUNXI_CCU_MUX_DATA(cpu_b_clk, "cpu-b", cpu_b_parents,
+			  0x201c, 24, 3, CLK_SET_RATE_PARENT | CLK_IS_CRITICAL);
+static SUNXI_CCU_MUX_DATA(cpu_dsu_clk, "cpu-dsu", cpu_dsu_parents,
+			  0x301c, 24, 3, CLK_SET_RATE_PARENT | CLK_IS_CRITICAL);
+
+static struct ccu_common *sun60i_a733_cpupll_ccu_clks[] = {
+	&pll_cpu_back_clk.common,
+	&pll_cpu_l_clk.common,
+	&pll_cpu_b_clk.common,
+	&pll_cpu_dsu_clk.common,
+	&cpu_l_clk.common,
+	&cpu_b_clk.common,
+	&cpu_dsu_clk.common,
+};
+
+static struct clk_hw_onecell_data sun60i_a733_cpupll_hw_clks = {
+	.hws	= {
+		[CLK_PLL_CPU_BACK]	= &pll_cpu_back_clk.common.hw,
+		[CLK_PLL_CPU_L]		= &pll_cpu_l_clk.common.hw,
+		[CLK_PLL_CPU_B]		= &pll_cpu_b_clk.common.hw,
+		[CLK_PLL_CPU_DSU]	= &pll_cpu_dsu_clk.common.hw,
+		[CLK_CPU_L]		= &cpu_l_clk.common.hw,
+		[CLK_CPU_B]		= &cpu_b_clk.common.hw,
+		[CLK_CPU_DSU]		= &cpu_dsu_clk.common.hw,
+	},
+	.num = CLK_CPUPLL_MAX_NO,
+};
+
+static const struct sunxi_ccu_desc sun60i_a733_cpupll_desc = {
+	.ccu_clks	= sun60i_a733_cpupll_ccu_clks,
+	.num_ccu_clks	= ARRAY_SIZE(sun60i_a733_cpupll_ccu_clks),
+	.hw_clks	= &sun60i_a733_cpupll_hw_clks,
+};
+
+static const u32 pll_regs[] = {
+	SUN60I_A733_PLL_CPU_BACK_REG,
+	SUN60I_A733_PLL_CPU_L_REG,
+	SUN60I_A733_PLL_CPU_B_REG,
+	SUN60I_A733_PLL_CPU_DSU_REG,
+};
+
+static const u32 pll_pat0_regs[] = {
+	SUN60I_A733_PLL_CPU_BACK_PAT0_REG,
+	SUN60I_A733_PLL_CPU_L_PAT0_REG,
+	SUN60I_A733_PLL_CPU_B_PAT0_REG,
+	SUN60I_A733_PLL_CPU_DSU_PAT0_REG,
+};
+
+static const u32 pll_pat1_regs[] = {
+	SUN60I_A733_PLL_CPU_BACK_PAT1_REG,
+	SUN60I_A733_PLL_CPU_L_PAT1_REG,
+	SUN60I_A733_PLL_CPU_B_PAT1_REG,
+	SUN60I_A733_PLL_CPU_DSU_PAT1_REG,
+};
+
+static const u32 pll_lfm_regs[] = {
+	SUN60I_A733_PLL_CPU_L_LFM_REG,
+	SUN60I_A733_PLL_CPU_B_LFM_REG,
+	SUN60I_A733_PLL_CPU_DSU_LFM_REG,
+};
+
+static void ccupll_helper_wait_for_lock(void __iomem *addr, u32 lock)
+{
+	u32 reg;
+
+	WARN_ON(readl_relaxed_poll_timeout(addr, reg, reg & lock, 100, 70000));
+}
+
+static void cpupll_helper_wait_for_clear(void __iomem *addr, u32 clear)
+{
+	u32 reg;
+
+	reg = readl(addr);
+	writel(reg | clear, addr);
+
+	WARN_ON(readl_relaxed_poll_timeout_atomic(addr, reg,
+						  !(reg & clear), 100, 10000));
+}
+
+static const u32 cpu_mux_regs[] = {
+	SUN60I_A733_CPU_L_REG,
+	SUN60I_A733_CPU_B_REG,
+	SUN60I_A733_CPU_DSU_REG,
+};
+
+static int sun60i_a733_cpupll_probe(struct platform_device *pdev)
+{
+	void __iomem *reg;
+	u32 val;
+	int i, ret;
+
+	reg = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(reg))
+		return PTR_ERR(reg);
+
+	for (i = 0; i < ARRAY_SIZE(pll_regs); i++) {
+		/*
+		 * Set the delta-sigma modulation to a fixed triangular
+		 * pattern and enable the loop filter mode.
+		 */
+		val = readl(reg + pll_pat0_regs[i]);
+		val |= BIT(29) | BIT(30);	/* use triangular (3 bit) */
+		writel(val, reg + pll_pat0_regs[i]);
+
+		val = readl(reg + pll_pat1_regs[i]);
+		val |= BIT(31);			/* enable lfm_en */
+		writel(val, reg + pll_pat1_regs[i]);
+
+		/* Set the pll_lfm_reg (pll_cpu_back has no lfm reg). */
+		if (i) {
+			val = readl(reg + pll_lfm_regs[i - 1]);
+			val &= ~BIT(0);
+			val |= BIT(31) | BIT(8);	/* 1.125MHz/us */
+			writel(val, reg + pll_lfm_regs[i - 1]);
+		}
+
+		cpupll_helper_wait_for_clear(reg + pll_regs[i], BIT(26));
+
+		/*
+		 * 1. Enable pll_en pll_ldo_en lock_en and the PLL output.
+		 * 2. Wait for update and lock.
+		 */
+		val = readl(reg + pll_regs[i]);
+		val |= BIT(27) | BIT(29) | BIT(30) | BIT(31);
+		writel(val, reg + pll_regs[i]);
+		cpupll_helper_wait_for_clear(reg + pll_regs[i], BIT(26));
+		ccupll_helper_wait_for_lock(reg + pll_regs[i], BIT(28));
+	}
+
+	/* Set the default PLL for each CPU cluster. */
+	for (i = 0; i < ARRAY_SIZE(cpu_mux_regs); i++) {
+		val = readl(reg + cpu_mux_regs[i]);
+		val &= ~GENMASK(26, 24);
+		val |= (0x3 << 24);
+		writel(val, reg + cpu_mux_regs[i]);
+	}
+
+	ret = devm_sunxi_ccu_probe(&pdev->dev, reg, &sun60i_a733_cpupll_desc);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static const struct of_device_id sun60i_a733_cpupll_ids[] = {
+	{ .compatible = "allwinner,sun60i-a733-cpupll" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_a733_cpupll_ids);
+
+static struct platform_driver sun60i_a733_cpupll_driver = {
+	.probe	= sun60i_a733_cpupll_probe,
+	.driver	= {
+		.name			= "sun60i-a733-cpupll",
+		.suppress_bind_attrs	= true,
+		.of_match_table		= sun60i_a733_cpupll_ids,
+	},
+};
+module_platform_driver(sun60i_a733_cpupll_driver);
+
+MODULE_IMPORT_NS("SUNXI_CCU");
+MODULE_DESCRIPTION("Support for the Allwinner A733 CPU PLL");
+MODULE_LICENSE("GPL");
