From e8e97fb00e7c8ecdc6e81d1b43995ee76ca18751 Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Wed, 18 Nov 2026 17:15:18 +0000
Subject: [PATCH 42/42] arm64: dts: allwinner: orangepi-4-pro: add Wi-Fi,
 Bluetooth and SoC ID

Describe the AIC8800D80: SDIO on mmc1 with WL_REG_ON as the supply
enable, Bluetooth on uart1, and PM2 as an rfkill line. Move the SMHC1
clock off the 24 MHz oscillator so SDIO can reach 50 MHz.

Add the SoC ID cell used for the GMAC address.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../sun60i-a733-orangepi-4-pro-sd.dts         | 88 +++++++++++++++++++
 1 file changed, 88 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts
index a652d0cb8..b9340961a 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts
@@ -20,6 +20,32 @@
 #include "sun60i-a733-orangepi-4-pro.dts"
 
 / {
+	aliases {
+		serial1 = &uart1;
+	};
+
+	/* Not used: WL_REG_ON is the enable pin of reg_wifi below. */
+	/delete-node/ sunxi-wlan;
+
+	/* PM2 holds the Bluetooth core in reset when low. */
+	rfkill-bt {
+		compatible = "rfkill-gpio";
+		label = "rfkill-bt";
+		radio-type = "bluetooth";
+		shutdown-gpios = <&r_pio 1 2 GPIO_ACTIVE_HIGH>;
+	};
+
+	/* AIC8800D80 power: the SDIO host switches it through WL_REG_ON. */
+	reg_wifi: regulator-wifi {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-wifi";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&r_pio 1 1 GPIO_ACTIVE_HIGH>; /* PM1, WL_REG_ON */
+		enable-active-high;
+		startup-delay-us = <50000>;
+	};
+
 	chosen {
 		/* Used when the boot script leaves bootargs empty. */
 		bootargs = "root=PARTUUID=e86ba129-01 rootwait rootfstype=ext4 earlycon=uart8250,mmio32,0x02500000 console=ttyS0,115200n8 console=tty1 consoleblank=0 loglevel=7 printk.time=1 clk_ignore_unused swiotlb=65536 cma=512M panic=10";
@@ -38,6 +64,21 @@ r_i2c0_pins: r-i2c0-pins {
 };
 
 &{/soc} {
+	/* AIC8800D80 Bluetooth, H4 at 1.5 Mbaud. */
+	uart1: serial@2501000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0x2501000 0x400>;
+		interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clocks = <&ccu CLK_UART1>;
+		resets = <&ccu RST_BUS_UART1>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&uart1_pins>;
+		uart-has-rtscts;
+		status = "okay";
+	};
+
 	r_i2c0: i2c@7083000 {
 		compatible = "allwinner,sun8i-v536-i2c",
 			     "allwinner,sun6i-a31-i2c";
@@ -63,6 +104,21 @@ pmic@36 {
 			reg = <0x36>;
 
 			regulators {
+				/* Vendor DT: 1.8 V I/O for the Wi-Fi/BT pins, banks PG and PM. */
+				reg_bldo5: bldo5 {
+					regulator-name = "vcc-pg";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-always-on;
+				};
+
+				reg_cldo1: cldo1 {
+					regulator-name = "vcc-pm";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-always-on;
+				};
+
 				/* SWOUT1 ("dc1sw1"): VCC-3V3-PHY. boot0 leaves it off. */
 				reg_swout1: swout1 {
 					regulator-name = "vcc-3v3-phy";
@@ -80,6 +136,13 @@ reg_swout2: swout2 {
 };
 
 &pio {
+	uart1_pins: uart1-pins {
+		pins = "PG6", "PG7", "PG8", "PG9";
+		function = "uart1";
+		allwinner,pinmux = <2>;
+		drive-strength = <10>;
+	};
+
 	mmc0_sd_pins: mmc0-sd-pins {
 		pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
 		function = "mmc0";
@@ -115,7 +178,16 @@ &gpu {
  * ("MDIO device at address 1 is missing"). The vendor driver hard-codes
  * clk_csr = 4: 200 MHz / 102 = ~2 MHz.
  */
+&sid {
+	sid_chip_id: chip-id@0 {
+		reg = <0x0 0x10>;
+	};
+};
+
 &gmac0 {
+	/* The board stores no MAC address: the driver derives one from this ID. */
+	nvmem-cells = <&sid_chip_id>;
+	nvmem-cell-names = "sid";
 	phy-supply = <&reg_swout1>;
 	snps,clk-csr = <4>;
 	/* without it stmmac finds no PHY at open, though YT8531 binds */
@@ -176,3 +248,19 @@ &mmc0 {
 	no-mmc;
 	status = "okay";
 };
+
+/* AIC8800D80 Wi-Fi on SDIO. */
+&mmc1 {
+	vmmc-supply = <&reg_wifi>;
+	vqmmc-supply = <&reg_bldo5>;
+	/* boot0 leaves this clock on the 24 MHz oscillator. */
+	assigned-clocks = <&ccu CLK_SMHC1>;
+	assigned-clock-parents = <&ccu CLK_PLL_PERI0_400M>;
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	non-removable;
+	keep-power-in-suspend;
+	no-sd;
+	no-mmc;
+	status = "okay";
+};
