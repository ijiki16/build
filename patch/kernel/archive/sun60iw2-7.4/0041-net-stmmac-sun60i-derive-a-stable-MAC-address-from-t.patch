From 1a92c3dde484f9bb056cd28e46ddd8c0ce503e74 Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Wed, 18 Nov 2026 17:15:18 +0000
Subject: [PATCH 41/42] net: stmmac: sun60i: derive a stable MAC address from
 the SoC ID

Boards without MAC address storage get a random address, so their DHCP
lease changes. Use the "sid" nvmem cell to generate a locally
administered address when no other address is available.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ethernet/stmicro/stmmac/dwmac-sun60i.c    | 39 +++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun60i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun60i.c
index 5bb7d0e5d..2877ae246 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun60i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun60i.c
@@ -13,13 +13,18 @@
 #include <linux/bits.h>
 #include <linux/bitfield.h>
 #include <linux/clk.h>
+#include <linux/crc32.h>
+#include <linux/etherdevice.h>
 #include <linux/module.h>
+#include <linux/nvmem-consumer.h>
 #include <linux/of.h>
 #include <linux/phy.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
 #include <linux/reset.h>
+#include <linux/slab.h>
 #include <linux/stmmac.h>
+#include <linux/unaligned.h>
 
 #include "stmmac.h"
 #include "stmmac_platform.h"
@@ -97,6 +102,34 @@ static int sun60i_gmac_syscfg(struct device *dev, void __iomem *syscfg_base,
 	return 0;
 }
 
+/* Boards have no MAC address storage: derive a stable address from the SoC ID. */
+static int sun60i_gmac_mac_from_sid(struct device *dev, u8 *mac)
+{
+	struct nvmem_cell *cell;
+	u32 crc, crc2;
+	size_t len;
+	u8 *sid;
+
+	cell = nvmem_cell_get(dev, "sid");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell) == -EPROBE_DEFER ? -EPROBE_DEFER : 0;
+
+	sid = nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(sid))
+		return 0;
+
+	crc = crc32_le(~0, sid, len);
+	crc2 = crc32_le(crc, sid, len);
+	kfree(sid);
+
+	mac[0] = 0x02; /* locally administered, unicast */
+	mac[1] = crc2 & 0xff;
+	put_unaligned_be32(crc, mac + 2);
+
+	return 0;
+}
+
 static int sun60i_gmac_probe(struct platform_device *pdev)
 {
 	struct plat_stmmacenet_data *plat_dat;
@@ -120,6 +153,12 @@ static int sun60i_gmac_probe(struct platform_device *pdev)
 	if (IS_ERR(plat_dat))
 		return PTR_ERR(plat_dat);
 
+	if (!is_valid_ether_addr(stmmac_res.mac)) {
+		ret = sun60i_gmac_mac_from_sid(dev, stmmac_res.mac);
+		if (ret)
+			return ret;
+	}
+
 	/* Unsupported on this generation of the IP. */
 	plat_dat->flags |= STMMAC_FLAG_SPH_DISABLE;
 	plat_dat->host_dma_width = 32;
