From 620445d940aa0e94e3367733c92a8ad6190ab3bf Mon Sep 17 00:00:00 2001
From: TumRedSun <TumRedSun@users.noreply.github.com>
Date: Tue, 17 Nov 2026 12:17:08 +0000
Subject: [PATCH 21/39] dts/a733-opi4pro: add sunxi-wlan and btlpm helper nodes

- sunxi-wlan: wlan_power (bldo5+cldo1), regon PM1, hostwake PM0, bus 1
  (mmc1); consumed by the out-of-tree sunxi-wlan helper module for the
  AIC8800 SDIO port
- btlpm: btwake/bthostwake PM3/PM4, uart1; consumed by aic8800_btlpm
---
 .../allwinner/sun60i-a733-orangepi-4-pro.dts  |  52 ++++++++
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 124 ++++++++++++++++++
 2 files changed, 176 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts
index d7131f974..15ab381c0 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts
@@ -25,6 +25,24 @@ aliases {
 		mmc1 = &mmc2;
 	};
 
+		bt-lpm {
+			compatible = "allwinner,sunxi-btlpm";
+			bt-wake-gpios = <&r_pio 1 3 GPIO_ACTIVE_HIGH>;      /* PM3 */
+			bt-hostwake-gpios = <&r_pio 1 4 GPIO_ACTIVE_HIGH>;  /* PM4 */
+			uart_index = <1>;
+			wakeup-source;
+		};
+
+	/* WiFi/BT module power + host-wake (AIC8800 on SMHC1, sunxi-wlan.ko) */
+	sunxi-wlan {
+		compatible = "allwinner,sunxi-wlan";
+		wlan-regon-gpios = <&r_pio 1 1 GPIO_ACTIVE_HIGH>;   /* PM1 = WL_REG_ON */
+		wlan-hostwake-gpios = <&r_pio 1 0 GPIO_ACTIVE_HIGH>; /* PM0 = OOB */
+		wlan_busnum = <1>;
+		wlan_mmc = <&mmc1>;
+		wakeup-source;
+	};
+
 	chosen {
 		stdout-path = "serial0:115200n8";
 		/* This vendor U-Boot drops the bootargs FDT fixup when booti is
@@ -125,3 +143,37 @@ gmac0_phy0: ethernet-phy@1 {
 		};
 	};
 };
+
+/* ---- display / DRM (HDMI0 on the DE -> TCON3 -> HDMI0 chain) ---- */
+&sunxi_drm {
+	status = "okay";
+};
+
+&de {
+	status = "okay";
+};
+
+&vo1 {
+	status = "okay";
+};
+
+&tv0 {
+	status = "okay";
+};
+
+&hdmi0 {
+	hdmi_hdcp1x_enable = <1>;
+	hdmi_hdcp2x_enable = <1>;
+	hdmi_cec_enable = <1>;
+	hdmi_clock_source = <0>;
+	hdmi_resistor_select = <1>;
+	hdmi_ddc_index = <20>;
+
+	snps_phy = <
+		25000 185625 0x0007 0x8160 0x8188
+		185625 185625 0x0007 0x8160 0x8198
+		185625 340000 0x0004 0x8040 0x8E85
+		340000 600000 0x0000 0x80c0 0x82F6>;
+
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 76da77b04..f24d81d50 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -514,6 +514,130 @@ pcie_intc: legacy-interrupt-controller {
 				#interrupt-cells = <1>;
 			};
 		};
+
+		sunxi_drm: drm-sunxi {
+			compatible = "allwinner,sunxi-drm";
+			fb_base = <0>;
+			status = "disabled";
+		};
+
+		de: de@5000000 {
+			compatible = "allwinner,display-engine-v352";
+			reg = <0x0 0x5000000 0x0 0x400000>;
+			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_DE0>,
+				 <&ccu CLK_BUS_DE0>,
+				 <&ccu CLK_DE_AHB_GATE>,
+				 <&ccu CLK_MBUS_DESYS_GATE>;
+			clock-names = "clk_de",
+				      "clk_bus_de",
+				      "ahb_vid_out",
+				      "mbus_vo_sys";
+			resets = <&ccu RST_BUS_DE0>,
+				 <&ccu RST_BUS_DE_SY>;
+			reset-names = "rst_bus_de",
+				      "rst_bus_de_sys";
+			assigned-clocks = <&ccu CLK_DE0>;
+			assigned-clock-parents = <&ccu CLK_PLL_DE_3X>;
+			assigned-clock-rates = <600000000>;
+			power-domains = <&pck600 PD_DE_SYS>;
+			/* NOTE: no iommus/nsi here - mainline has neither mmu_aw
+			 * nor nsi yet; DE relies on CMA (swiotlb=65536) */
+			chn_cfg_mode = <0>;
+			status = "disabled";
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				disp0: port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+					disp0_out_tcon3: endpoint {
+						remote-endpoint = <&tcon3_in_disp0>;
+					};
+				};
+			};
+		};
+
+		vo1: vo-top@5510000 {
+			compatible = "allwinner,tcon-top1";
+			reg = <0x0 0x05510000 0x0 0x1000>;
+			clocks = <&ccu CLK_DPSS_TOP1>,
+				 <&ccu CLK_VID_OUT1_AHB_GATE>;
+			clock-names = "clk_bus_dpss_top",
+				      "clk_ahb_gate";
+			resets = <&ccu RST_BUS_DPSS_TOP1>,
+				 <&ccu RST_BUS_VIDEO_OUT1>;
+			reset-names = "rst_bus_dpss_top",
+				      "rst_bus_reg";
+			power-domains = <&pck600 PD_VO1>;
+			status = "disabled";
+		};
+
+		tv0: tcon-tv@5730000 {
+			compatible = "allwinner,tcon-tv";
+			reg = <0x0 0x05730000 0x0 0x1000>;
+			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_TCONTV0>;
+			clock-names = "clk_bus_tcon";
+			resets = <&ccu RST_BUS_TCONTV0>;
+			reset-names = "rst_bus_tcon";
+			top = <&vo1>;
+			status = "disabled";
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				tcon3_in: port@0 {
+					reg = <0>;
+					tcon3_in_disp0: endpoint {
+						remote-endpoint = <&disp0_out_tcon3>;
+					};
+				};
+				tcon3_out: port@1 {
+					reg = <1>;
+					tcon3_out_hdmi0: endpoint {
+						remote-endpoint = <&hdmi0_in_tcon3>;
+					};
+				};
+			};
+		};
+
+		hdmi0: hdmi@5520000 {
+			compatible = "allwinner,sunxi-hdmi";
+			reg = <0x0 0x05520000 0x0 0x100000>;
+			interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_HDMI_REF>,
+				 <&ccu CLK_HDMI>,
+				 <&ccu CLK_HDMI_SFR>,
+				 <&ccu CLK_HDCP_ESM>,
+				 <&osc24M>;
+			clock-names = "clk_cec",
+				      "clk_hdmi",
+				      "clk_hdmi_24M",
+				      "clk_hdcp",
+				      "clk_dcxo";
+			resets = <&ccu RST_BUS_HDMI_SUB>,
+				 <&ccu RST_BUS_HDMI_MAIN>,
+				 <&ccu RST_BUS_HDMI_HDCP>;
+			reset-names = "rst_bus_sub",
+				      "rst_bus_main",
+				      "rst_bus_hdcp";
+			power-domains = <&pck600 PD_VO1>;
+			status = "disabled";
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				hdmi_in: port@0 {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					reg = <0>;
+					hdmi0_in_tcon3: endpoint {
+						remote-endpoint = <&tcon3_out_hdmi0>;
+					};
+				};
+			};
+		};
 	};
 
 	thermal-zones {
