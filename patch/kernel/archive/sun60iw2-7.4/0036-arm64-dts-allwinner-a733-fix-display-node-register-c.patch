From 4f96c6bde1939acc0754f7ab4b669a2a905c8abd Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:17:30 +0000
Subject: [PATCH 36/39] arm64: dts: allwinner: a733: fix display node register
 cells

The /soc bus uses one address cell and one size cell, but the DE,
VO-TOP, TCON-TV and HDMI nodes use the vendor's two-cell format. Linux
therefore reads address 0 with size 0x5000000 for the display engine:

  sunxi-display-engine 0.de: can't request region for resource
  [mem 0x00000000-0x04ffffff]

Use one address cell and one size cell, as the rest of the bus does.

Tested on an OrangePi 4 Pro: the devices appear as 5000000.de,
5510000.vo-top, 5520000.hdmi and 5730000.tcon-tv.

Made with the help of an AI coding assistant (Claude).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 788de87df..164f158db 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -543,7 +543,7 @@ sunxi_drm: drm-sunxi {
 
 		de: de@5000000 {
 			compatible = "allwinner,display-engine-v352";
-			reg = <0x0 0x5000000 0x0 0x400000>;
+			reg = <0x5000000 0x400000>;
 			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&ccu CLK_DE0>,
@@ -582,7 +582,7 @@ disp0_out_tcon3: endpoint {
 
 		vo1: vo-top@5510000 {
 			compatible = "allwinner,tcon-top1";
-			reg = <0x0 0x05510000 0x0 0x1000>;
+			reg = <0x05510000 0x1000>;
 			clocks = <&ccu CLK_DPSS_TOP1>,
 				 <&ccu CLK_VID_OUT1_AHB_GATE>;
 			clock-names = "clk_bus_dpss_top",
@@ -597,7 +597,7 @@ vo1: vo-top@5510000 {
 
 		tv0: tcon-tv@5730000 {
 			compatible = "allwinner,tcon-tv";
-			reg = <0x0 0x05730000 0x0 0x1000>;
+			reg = <0x05730000 0x1000>;
 			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&ccu CLK_TCONTV0>;
 			clock-names = "clk_bus_tcon";
@@ -625,7 +625,7 @@ tcon3_out_hdmi0: endpoint {
 
 		hdmi0: hdmi@5520000 {
 			compatible = "allwinner,sunxi-hdmi";
-			reg = <0x0 0x05520000 0x0 0x100000>;
+			reg = <0x05520000 0x100000>;
 			interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&ccu CLK_HDMI_REF>,
 				 <&ccu CLK_HDMI>,
