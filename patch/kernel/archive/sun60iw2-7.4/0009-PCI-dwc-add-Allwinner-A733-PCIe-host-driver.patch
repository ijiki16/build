Subject: [PATCH 09/39] PCI: dwc: add Allwinner A733 PCIe host driver

---
 drivers/pci/controller/dwc/Kconfig            |  13 +
 drivers/pci/controller/dwc/Makefile           |   1 +
 drivers/pci/controller/dwc/pcie-sun60i-a733.c | 437 ++++++++++++++++++
 3 files changed, 451 insertions(+)
 create mode 100644 drivers/pci/controller/dwc/pcie-sun60i-a733.c

diff --git a/drivers/pci/controller/dwc/Kconfig b/drivers/pci/controller/dwc/Kconfig
index 0a0d56fcf..b6f1a3181 100644
--- a/drivers/pci/controller/dwc/Kconfig
+++ b/drivers/pci/controller/dwc/Kconfig
@@ -455,6 +455,19 @@ config PCIE_SPACEMIT_K1
 	  are available on the K1 SoC; the first of these shares a PHY
 	  with a USB 3.0 host controller (one or the other can be used).
 
+config PCIE_SUN60I_A733
+	tristate "Allwinner A733 PCIe controller (host mode)"
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on PCI_MSI
+	select PCIE_DW_HOST
+	select GENERIC_PHY
+	default ARCH_SUNXI
+	help
+	  Enables support for the DesignWare based PCIe host controller
+	  found in the Allwinner A733 SoC.  The PCIe slot is served by
+	  the serdes/combophy subsystem; NVMe SSDs and other devices
+	  hanging off the M.2 slot are supported through a single lane.
+
 config PCIE_SPEAR13XX
 	bool "STMicroelectronics SPEAr PCIe controller"
 	depends on ARCH_SPEAR13XX || COMPILE_TEST
