diff --git a/drivers/pci/controller/dwc/pcie-sun60i-a733.c b/drivers/pci/controller/dwc/pcie-sun60i-a733.c
new file mode 100644
index 000000000..7e683c220
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-sun60i-a733.c
@@ -0,0 +1,437 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DesignWare PCIe host controller driver for Allwinner SoCs.
+ *
+ * Copyright (C) 2026 tumredsun <tumredsun@localhost>
+ *
+ * The Allwinner A733 DesignWare PCIe host controller has a dedicated
+ * "app" register block at DBI + 0x400000, which carries the LTSSM
+ * control register and the (S)II interrupt status registers used to
+ * detect the legacy INTx events.  The "its" clock feeds the dedicated
+ * MSI controller towards the GIC ITS block.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/irq.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+
+#include "pcie-designware.h"
+
+/* Allwinner PCIe "app" register block, offsets from DBI + 0x400000. */
+#define PCIE_LTSSM_ENABLE			0x0c00
+#define   APP_LTSSM_ENABLE			BIT(0)
+#define SII_INT_MASK0				0x0e00
+#define   INTX_TX_DEASSERT_MASK			GENMASK(28, 25)
+#define   INTX_TX_ASSERT_MASK			GENMASK(24, 21)
+#define   INTX_RX_DEASSERT_MASK			GENMASK(12, 9)
+#define   INTX_RX_ASSERT_MASK			GENMASK(8, 5)
+#define   INTX_RX_ASSERT(x)			BIT((x) + __ffs(INTX_RX_ASSERT_MASK))
+#define SII_INT_STAS0				0x0e08
+#define SII_INT_MASK1				0x0e04
+#define   RDLH_LINK_UP				BIT(1)
+#define   SMLH_LINK_UP				BIT(0)
+#define SII_INT_STAS1				0x0e0c
+
+#define SUNXI_PCIE_APP_OFFSET			0x400000
+
+static const struct clk_bulk_data sun60i_a733_pcie_clks[] = {
+	{ .id = "aux" },
+	{ .id = "slv" },
+	{ .id = "gio" },
+};
+
+static const struct reset_control_bulk_data sun60i_a733_pcie_rsts[] = {
+	{ .id = "core" },
+	{ .id = "pwr" },
+	{ .id = "gio" },
+};
+
+struct sun60i_a733_pcie {
+	struct dw_pcie		pci;
+
+	void __iomem		*app_base;
+	struct clk_bulk_data	clks[ARRAY_SIZE(sun60i_a733_pcie_clks)];
+	size_t			clk_cnt;
+	struct reset_control_bulk_data
+				rsts[ARRAY_SIZE(sun60i_a733_pcie_rsts)];
+	size_t			rst_cnt;
+
+	struct phy		*phy;
+
+	struct irq_domain	*intx_domain;
+	int			sii_irq;
+
+	struct gpio_desc	*rst_gpio;
+	struct gpio_desc	*wake_gpio;
+};
+
+static inline struct sun60i_a733_pcie *to_sun60i_pcie(struct dw_pcie *pci)
+{
+	return container_of(pci, struct sun60i_a733_pcie, pci);
+}
+
+static void sun60i_a733_pcie_app_writel(struct sun60i_a733_pcie *pcie, u32 reg,
+					u32 val)
+{
+	writel(val, pcie->app_base + reg);
+}
+
+static u32 sun60i_a733_pcie_app_readl(struct sun60i_a733_pcie *pcie, u32 reg)
+{
+	return readl(pcie->app_base + reg);
+}
+
+static void sun60i_a733_pcie_intx_irq_mask(struct irq_data *d)
+{
+	struct sun60i_a733_pcie *pcie = irq_data_get_irq_chip_data(d);
+	irq_hw_number_t hwirq = irqd_to_hwirq(d);
+	u32 offset = INTX_RX_ASSERT(hwirq);
+	unsigned long flags;
+	u32 val;
+
+	raw_spin_lock_irqsave(&pcie->pci.pp.lock, flags);
+
+	/* The SII_INT_STAS0 register latches the INTx events. */
+	val = sun60i_a733_pcie_app_readl(pcie, SII_INT_STAS0);
+	val |= offset;
+	sun60i_a733_pcie_app_writel(pcie, SII_INT_STAS0, val);
+
+	val = sun60i_a733_pcie_app_readl(pcie, SII_INT_MASK0);
+	val &= ~offset;
+	sun60i_a733_pcie_app_writel(pcie, SII_INT_MASK0, val);
+
+	raw_spin_unlock_irqrestore(&pcie->pci.pp.lock, flags);
+}
+
+static void sun60i_a733_pcie_intx_irq_unmask(struct irq_data *d)
+{
+	struct sun60i_a733_pcie *pcie = irq_data_get_irq_chip_data(d);
+	irq_hw_number_t hwirq = irqd_to_hwirq(d);
+	u32 offset = INTX_RX_ASSERT(hwirq);
+	unsigned long flags;
+	u32 val;
+
+	raw_spin_lock_irqsave(&pcie->pci.pp.lock, flags);
+
+	/* The SII_INT_STAS0 register latches the INTx events. */
+	val = sun60i_a733_pcie_app_readl(pcie, SII_INT_STAS0);
+	val |= offset;
+	sun60i_a733_pcie_app_writel(pcie, SII_INT_STAS0, val);
+
+	val = sun60i_a733_pcie_app_readl(pcie, SII_INT_MASK0);
+	val |= offset;
+	sun60i_a733_pcie_app_writel(pcie, SII_INT_MASK0, val);
+
+	raw_spin_unlock_irqrestore(&pcie->pci.pp.lock, flags);
+}
+
+static struct irq_chip sun60i_a733_pcie_intx_chip = {
+	.name		= "PCI-INTx",
+	.irq_mask	= sun60i_a733_pcie_intx_irq_mask,
+	.irq_unmask	= sun60i_a733_pcie_intx_irq_unmask,
+	.flags		= IRQCHIP_SKIP_SET_WAKE | IRQCHIP_MASK_ON_SUSPEND,
+};
+
+static int sun60i_a733_pcie_intx_map(struct irq_domain *domain,
+				     unsigned int irq, irq_hw_number_t hwirq)
+{
+	irq_set_chip_and_handler(irq, &sun60i_a733_pcie_intx_chip,
+				 handle_level_irq);
+	irq_set_chip_data(irq, domain->host_data);
+
+	return 0;
+}
+
+static const struct irq_domain_ops sun60i_a733_pcie_intx_domain_ops = {
+	.map	= sun60i_a733_pcie_intx_map,
+};
+
+static void sun60i_a733_pcie_intx_handler(struct irq_desc *desc)
+{
+	struct sun60i_a733_pcie *pcie = irq_desc_get_handler_data(desc);
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+	unsigned long active, hwirq;
+
+	chained_irq_enter(chip, desc);
+
+	active = sun60i_a733_pcie_app_readl(pcie, SII_INT_STAS0) &
+		 INTX_RX_ASSERT_MASK;
+
+	for_each_set_bit(hwirq, &active, PCI_NUM_INTX) {
+		/* Clear the pending INTx event. */
+		sun60i_a733_pcie_app_writel(pcie, SII_INT_STAS0,
+					    BIT(hwirq + __ffs(INTX_RX_ASSERT_MASK)));
+		generic_handle_domain_irq(pcie->intx_domain, hwirq);
+	}
+
+	chained_irq_exit(chip, desc);
+}
+
+static bool sun60i_a733_pcie_link_up(struct dw_pcie *pci)
+{
+	struct sun60i_a733_pcie *pcie = to_sun60i_pcie(pci);
+	u32 val;
+
+	val = sun60i_a733_pcie_app_readl(pcie, SII_INT_STAS1);
+
+	return (val & RDLH_LINK_UP) && (val & SMLH_LINK_UP);
+}
+
+static void sun60i_a733_pcie_ltssm_enable(struct sun60i_a733_pcie *pcie)
+{
+	u32 val;
+
+	val = sun60i_a733_pcie_app_readl(pcie, PCIE_LTSSM_ENABLE);
+	val |= APP_LTSSM_ENABLE;
+	sun60i_a733_pcie_app_writel(pcie, PCIE_LTSSM_ENABLE, val);
+}
+
+static void sun60i_a733_pcie_ltssm_disable(struct sun60i_a733_pcie *pcie)
+{
+	u32 val;
+
+	val = sun60i_a733_pcie_app_readl(pcie, PCIE_LTSSM_ENABLE);
+	val &= ~APP_LTSSM_ENABLE;
+	sun60i_a733_pcie_app_writel(pcie, PCIE_LTSSM_ENABLE, val);
+}
+
+static int sun60i_a733_pcie_start_link(struct dw_pcie *pci)
+{
+	struct sun60i_a733_pcie *pcie = to_sun60i_pcie(pci);
+
+	sun60i_a733_pcie_ltssm_enable(pcie);
+
+	return 0;
+}
+
+static void sun60i_a733_pcie_stop_link(struct dw_pcie *pci)
+{
+	struct sun60i_a733_pcie *pcie = to_sun60i_pcie(pci);
+
+	sun60i_a733_pcie_ltssm_disable(pcie);
+	gpiod_set_value_cansleep(pcie->rst_gpio, 1);
+}
+
+static const struct dw_pcie_ops sun60i_a733_pcie_ops = {
+	.link_up	= sun60i_a733_pcie_link_up,
+	.start_link	= sun60i_a733_pcie_start_link,
+	.stop_link	= sun60i_a733_pcie_stop_link,
+};
+
+static int sun60i_a733_pcie_hw_init(struct sun60i_a733_pcie *pcie)
+{
+	struct dw_pcie *pci = &pcie->pci;
+	struct device *dev = pci->dev;
+	int ret;
+
+	ret = devm_regulator_get_enable(dev, "vpcie3v3");
+	if (ret)
+		return dev_err_probe(dev, ret, "no pcie3v3-supply\n");
+
+	ret = devm_regulator_get_enable_optional(dev, "vpcie1v8");
+	if (ret < 0 && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "no pcie1v8-supply\n");
+
+	ret = reset_control_bulk_deassert(pcie->rst_cnt, pcie->rsts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to deassert resets\n");
+
+	ret = clk_bulk_prepare_enable(pcie->clk_cnt, pcie->clks);
+	if (ret)
+		goto err_assert_resets;
+
+	ret = phy_init(pcie->phy);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init the PHY\n");
+		goto err_disable_clks;
+	}
+
+	/* Assert PERST#, wait, then release it. */
+	gpiod_set_value_cansleep(pcie->rst_gpio, 1);
+	msleep(100);
+	gpiod_set_value_cansleep(pcie->rst_gpio, 0);
+	gpiod_set_value_cansleep(pcie->wake_gpio, 1);
+
+	return 0;
+
+err_disable_clks:
+	clk_bulk_disable_unprepare(pcie->clk_cnt, pcie->clks);
+err_assert_resets:
+	reset_control_bulk_assert(pcie->rst_cnt, pcie->rsts);
+
+	return ret;
+}
+
+static void sun60i_a733_pcie_hw_deinit(struct sun60i_a733_pcie *pcie)
+{
+	phy_exit(pcie->phy);
+	clk_bulk_disable_unprepare(pcie->clk_cnt, pcie->clks);
+	reset_control_bulk_assert(pcie->rst_cnt, pcie->rsts);
+}
+
+static int sun60i_a733_pcie_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct sun60i_a733_pcie *pcie = to_sun60i_pcie(pci);
+	struct device_node *intc;
+	int ret;
+
+	ret = sun60i_a733_pcie_hw_init(pcie);
+	if (ret)
+		return ret;
+
+	intc = of_get_child_by_name(dev_of_node(pci->dev),
+				   "legacy-interrupt-controller");
+	if (!intc) {
+		dev_err(pci->dev, "missing legacy-interrupt-controller node\n");
+		ret = -EINVAL;
+		goto err_hw_deinit;
+	}
+
+	pcie->intx_domain = irq_domain_create_linear(of_fwnode_handle(intc),
+						     PCI_NUM_INTX,
+						     &sun60i_a733_pcie_intx_domain_ops,
+						     pcie);
+	of_node_put(intc);
+	if (!pcie->intx_domain) {
+		ret = -ENODEV;
+		goto err_hw_deinit;
+	}
+
+	irq_set_chained_handler_and_data(pcie->sii_irq,
+					 sun60i_a733_pcie_intx_handler, pcie);
+
+	return 0;
+
+err_hw_deinit:
+	sun60i_a733_pcie_hw_deinit(pcie);
+	return ret;
+}
+
+static void sun60i_a733_pcie_deinit(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct sun60i_a733_pcie *pcie = to_sun60i_pcie(pci);
+
+	irq_set_chained_handler_and_data(pcie->sii_irq, NULL, NULL);
+
+	if (pcie->intx_domain) {
+		irq_domain_remove(pcie->intx_domain);
+		pcie->intx_domain = NULL;
+	}
+
+	sun60i_a733_pcie_hw_deinit(pcie);
+}
+
+static const struct dw_pcie_host_ops sun60i_a733_pcie_host_ops = {
+	.init		= sun60i_a733_pcie_init,
+	.deinit		= sun60i_a733_pcie_deinit,
+};
+
+static int sun60i_a733_pcie_resource_get(struct platform_device *pdev,
+					 struct sun60i_a733_pcie *pcie)
+{
+	struct dw_pcie *pci = &pcie->pci;
+	struct device *dev = pci->dev;
+	void __iomem *dbi;
+	int ret;
+
+	dbi = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dbi))
+		return dev_err_probe(dev, PTR_ERR(dbi), "failed to map dbi\n");
+
+	pci->dbi_base = dbi;
+	pcie->app_base = dbi + SUNXI_PCIE_APP_OFFSET;
+
+	pcie->clk_cnt = ARRAY_SIZE(pcie->clks);
+	ret = devm_clk_bulk_get_optional(dev, pcie->clk_cnt, pcie->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	pcie->rst_cnt = ARRAY_SIZE(pcie->rsts);
+	ret = devm_reset_control_bulk_get_optional_shared(dev, pcie->rst_cnt,
+							  pcie->rsts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get resets\n");
+
+	pcie->rst_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(pcie->rst_gpio))
+		return dev_err_probe(dev, PTR_ERR(pcie->rst_gpio),
+				     "failed to get reset-gpios\n");
+
+	pcie->wake_gpio = devm_gpiod_get_optional(dev, "wake", GPIOD_OUT_HIGH);
+	if (IS_ERR(pcie->wake_gpio))
+		return dev_err_probe(dev, PTR_ERR(pcie->wake_gpio),
+				     "failed to get wake-gpios\n");
+
+	pcie->phy = devm_phy_get(dev, "pcie");
+	if (IS_ERR(pcie->phy))
+		return dev_err_probe(dev, PTR_ERR(pcie->phy),
+				     "failed to get the PHY\n");
+
+	pcie->sii_irq = platform_get_irq_byname(pdev, "legacy");
+	if (pcie->sii_irq < 0)
+		return dev_err_probe(dev, pcie->sii_irq,
+				     "failed to get sii IRQ\n");
+
+	return 0;
+}
+
+static int sun60i_a733_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sun60i_a733_pcie *pcie;
+	int ret;
+
+	pcie = devm_kzalloc(dev, sizeof(*pcie), GFP_KERNEL);
+	if (!pcie)
+		return -ENOMEM;
+
+	pcie->pci.dev = dev;
+	pcie->pci.ops = &sun60i_a733_pcie_ops;
+	pcie->pci.pp.ops = &sun60i_a733_pcie_host_ops;
+
+	ret = sun60i_a733_pcie_resource_get(pdev, pcie);
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, pcie);
+
+	return dw_pcie_host_init(&pcie->pci.pp);
+}
+
+static void sun60i_a733_pcie_remove(struct platform_device *pdev)
+{
+	struct sun60i_a733_pcie *pcie = platform_get_drvdata(pdev);
+
+	dw_pcie_host_deinit(&pcie->pci.pp);
+}
+
+static const struct of_device_id sun60i_a733_pcie_of_match_table[] = {
+	{ .compatible = "allwinner,sun60i-a733-pcie" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_a733_pcie_of_match_table);
+
+static struct platform_driver sun60i_a733_pcie_driver = {
+	.probe		= sun60i_a733_pcie_probe,
+	.remove		= sun60i_a733_pcie_remove,
+	.driver = {
+		.name		= "sun60i-a733-pcie",
+		.of_match_table	= sun60i_a733_pcie_of_match_table,
+	},
+};
+module_platform_driver(sun60i_a733_pcie_driver);
+
+MODULE_AUTHOR("tumredsun <tumredsun@localhost>");
+MODULE_DESCRIPTION("Allwinner A733 DesignWare PCIe host driver");
+MODULE_LICENSE("GPL");
