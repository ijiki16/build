From d8b1edd8d6ffdba9ea1521cc9b7385d6051bac87 Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:17:30 +0000
Subject: [PATCH 39/39] arm64: dts: allwinner: a733: feed the HDMI PHY from the
 DCXO

The HDMI PHY PLL is calculated from the rate of its "clk_dcxo" input,
but the node passes the fixed 24 MHz osc24M. On the 26 MHz OrangePi 4
Pro the pixel clock came out about 8% too fast, and the monitor showed
moving coloured lines. The vendor device tree uses the real DCXO.

Tested on an OrangePi 4 Pro: 1920x1080@60 shows readable text and
correct colour bars.

Made with the help of an AI coding assistant (Claude).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 8655bbfbf..a05755629 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -633,7 +633,7 @@ hdmi0: hdmi@5520000 {
 				 <&ccu CLK_HDMI>,
 				 <&ccu CLK_HDMI_SFR>,
 				 <&ccu CLK_HDCP_ESM>,
-				 <&osc24M>;
+				 <&dcxo>;
 			clock-names = "clk_cec",
 				      "clk_hdmi",
 				      "clk_hdmi_24M",
