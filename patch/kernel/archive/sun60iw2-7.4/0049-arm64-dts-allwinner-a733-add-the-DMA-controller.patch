From 75eac93dbb66a698c9546a0e25c99809ce980cf4 Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:57:07 +0000
Subject: [PATCH 49/50] arm64: dts: allwinner: a733: add the DMA controller

The mainline sun6i-dma driver supports the A733. Values follow the
vendor device tree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index c4283b753..d052818ca 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -274,6 +274,18 @@ ths_calibration: thermal-sensor-calibration@44 {
 			};
 		};
 
+		dma: dma-controller@4601000 {
+			compatible = "allwinner,sun60i-a733-dma";
+			reg = <0x4601000 0x2000>;
+			interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_DMA0>, <&ccu CLK_MBUS_DMA0>;
+			clock-names = "bus", "mbus";
+			resets = <&ccu RST_BUS_DMA0>;
+			dma-channels = <16>;
+			dma-requests = <64>;
+			#dma-cells = <1>;
+		};
+
 		rtc: rtc@7090000 {
 			compatible = "allwinner,sun60i-a733-rtc";
 			reg = <0x7090000 0x400>;
