From 64fb6eb274de2b39131098ad03312578ad26c7ac Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:57:08 +0000
Subject: [PATCH 50/50] arm64: dts: allwinner: orangepi-4-pro: use DMA for the
 SPI flash

Without DMA the SPI controller dropped bytes on reads, even at 20 MHz.
With DMA request 23 (as in the vendor device tree) reads are stable at
50 MHz: 6.2 MB/s instead of 2.5 MB/s.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts     | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts
index 6f7b14ca6..978ed331a 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro-sd.dts
@@ -208,6 +208,8 @@ spi0: spi@2540000 {
 		clocks = <&ccu CLK_BUS_SPI0>, <&ccu CLK_SPI0>;
 		clock-names = "ahb", "mod";
 		resets = <&ccu RST_BUS_SPI0>;
+		dmas = <&dma 23>, <&dma 23>;
+		dma-names = "tx", "rx";
 		pinctrl-names = "default";
 		pinctrl-0 = <&spi0_pins>;
 		#address-cells = <1>;
@@ -216,8 +218,7 @@ spi0: spi@2540000 {
 		flash@0 {
 			compatible = "jedec,spi-nor";
 			reg = <0>;
-			/* At 50 MHz without DMA the controller drops bytes on reads. */
-			spi-max-frequency = <20000000>;
+			spi-max-frequency = <50000000>;
 
 			partitions {
 				compatible = "fixed-partitions";
