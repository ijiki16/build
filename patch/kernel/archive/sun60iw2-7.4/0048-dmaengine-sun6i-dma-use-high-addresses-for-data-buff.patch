From d7021c0a6ae7a4990b9f9c80183dc2ea03d7a2d3 Mon Sep 17 00:00:00 2001
From: Iuri Jikidze <37273763+ijiki16@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:57:07 +0000
Subject: [PATCH 48/50] dmaengine: sun6i-dma: use high addresses for data
 buffers

Controllers with high address bits can reach memory above 4 GiB, but
the driver kept the default 32-bit DMA mask. On boards with more than
4 GiB every buffer above that went through swiotlb, and transfers larger
than one swiotlb mapping (256 KiB) failed.

Set the streaming mask from the high address bits. Keep the coherent
mask at 32 bits: the descriptors stay below 4 GiB, because the link to
the next descriptor has no high address bits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/dma/sun6i-dma.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/dma/sun6i-dma.c b/drivers/dma/sun6i-dma.c
index 3b849833e..c760983fd 100644
--- a/drivers/dma/sun6i-dma.c
+++ b/drivers/dma/sun6i-dma.c
@@ -1441,6 +1441,18 @@ static int sun6i_dma_probe(struct platform_device *pdev)
 
 	dma_set_max_seg_size(&pdev->dev, SZ_32M - 1);
 
+	/*
+	 * Controllers with high address bits reach above 4 GiB for data, so
+	 * buffers there need no bounce buffer. The descriptors stay below
+	 * 4 GiB: the link to the next descriptor has no high address bits.
+	 */
+	if (sdc->cfg->src_high_addr_mask) {
+		ret = dma_set_mask(&pdev->dev,
+				   DMA_BIT_MASK(32 + hweight32(sdc->cfg->src_high_addr_mask)));
+		if (ret)
+			dev_warn(&pdev->dev, "cannot use high addresses: %d\n", ret);
+	}
+
 	dma_cap_set(DMA_PRIVATE, sdc->slave.cap_mask);
 	dma_cap_set(DMA_MEMCPY, sdc->slave.cap_mask);
 	dma_cap_set(DMA_SLAVE, sdc->slave.cap_mask);
