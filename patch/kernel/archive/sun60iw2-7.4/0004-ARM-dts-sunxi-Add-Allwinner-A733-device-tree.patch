 .../nvmem/allwinner,sun4i-a10-sid.yaml        |   1 +
 .../watchdog/allwinner,sun4i-a10-wdt.yaml     |   2 +
 arch/arm64/boot/dts/allwinner/Makefile        |   1 +
 .../allwinner/sun60i-a733-orangepi-4-pro.dts  |  38 ++
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 351 ++++++++++++++++++
