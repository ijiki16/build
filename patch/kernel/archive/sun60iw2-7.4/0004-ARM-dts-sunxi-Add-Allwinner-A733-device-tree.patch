 drivers/rtc/rtc-sun6i.c                       |   4 +
 drivers/thermal/sun8i_thermal.c               |   8 +-
 drivers/watchdog/sunxi_wdt.c                  |   1 +
 .../dt-bindings/clock/sun60i-a733-rtc-ccu.h   |  26 --
 12 files changed, 543 insertions(+), 29 deletions(-)
