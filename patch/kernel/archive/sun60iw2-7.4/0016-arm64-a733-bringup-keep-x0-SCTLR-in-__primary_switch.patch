From 1ce51ec99a38d665fea3246620294049aabc6350 Mon Sep 17 00:00:00 2001
From: tumredsun <tumredsun@localhost>
Date: Thu, 22 Oct 2026 11:05:27 +0000
Subject: [PATCH 16/39] arm64/a733 bringup: keep x0 (SCTLR) in
 __primary_switch; uart_putc uses scratch regs

The extra dcache_clean_poc calls added in 7b47969ae clobbered x0
between __cpu_setup and __enable_mmu, so SCTLR got the clean range
end address instead of the intended value: M=0 (MMU stayed off) and
EE=1 (data accesses big-endian). Page-table descriptors then failed
to parse and the first ldr with MMU off took an external abort.

The tables are already cleaned in primary_entry after
__pi_create_init_idmap, so drop the redundant cleaning. Also switch
uart_putc to x16/x17; it ran inside __enable_mmu and clobbered
callee-saved x22/x23.

Verified in QEMU (virt): pte stores are little-endian, and the kernel
reaches start_kernel and boots to the rootfs mount.
---
 arch/arm64/kernel/head.S | 16 +++-------------
 1 file changed, 3 insertions(+), 13 deletions(-)

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 9700a8e3e..88ab6ab7a 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -83,9 +83,9 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 	.macro uart_putc, ch
-	movz	x22, #0x0250, lsl #16
-	mov	w23, #\ch
-	str	w23, [x22]
+	movz	x16, #0x0250, lsl #16
+	mov	w17, #\ch
+	str	w17, [x16]
 	.endm
 
 SYM_CODE_START(primary_entry)
@@ -526,16 +526,6 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 	uart_putc 'B'
 	uart_putc '4'					// A733 debug: enabling MMU
 
-	adrp	x0, __pi_init_idmap_pg_dir
-	adr_l	x1, __pi_init_idmap_pg_end
-	adr_l	x2, dcache_clean_poc
-	blr	x2
-
-	adrp	x0, reserved_pg_dir
-	adr_l	x1, swapper_pg_dir
-	adr_l	x2, dcache_clean_poc
-	blr	x2
-
 	adrp	x1, reserved_pg_dir
 	adrp	x2, __pi_init_idmap_pg_dir
 	bl	__enable_mmu
