From 7265f01b197bd61497c9fc830de0e4cd62643113 Mon Sep 17 00:00:00 2001
From: tumredsun <tumredsun@localhost>
Date: Wed, 21 Oct 2026 05:32:36 +0000
Subject: [PATCH 10/28] ARM: dts: sunxi: enable SerDes combo PHY and PCIe host
 on A733

---
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 24596f040..6fcb602c3 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -332,6 +332,71 @@ mmc2: mmc@4022000 {
 			#address-cells = <1>;
 			#size-cells = <0>;
 		};
+
+		serdes: phy@6c00000 {
+			compatible = "allwinner,sun60i-a733-serdes";
+			reg = <0x6c00000 0x400>,
+			      <0x6c06000 0x2000>,
+			      <0x6c02000 0xa00>,
+			      <0x6ca0000 0x20000>;
+			clocks = <&ccu CLK_SERDES_PHY_CFG>,
+				 <&rtc CLK_HOSC_SERDES1>;
+			clock-names = "serdes-clk", "dcxo-serdes1-clk";
+			resets = <&ccu RST_BUS_SERDES>;
+			reset-names = "serdes-reset";
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
+		pcie: pcie@6000000 {
+			compatible = "allwinner,sun60i-a733-pcie";
+			device_type = "pci";
+			reg = <0x6000000 0x480000>,
+			      <0x20000000 0x1000000>;
+			reg-names = "dbi", "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			bus-range = <0x0 0xff>;
+			ranges = <0x01000000 0x0 0x21000000 0x21000000 0x0 0x1000000>,
+				 <0x02000000 0x0 0x22000000 0x22000000 0x0 0x6000000>;
+			num-lanes = <1>;
+			max-link-speed = <3>;
+			num-ib-windows = <16>;
+			num-ob-windows = <16>;
+
+			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "legacy", "msi";
+
+			clocks = <&ccu CLK_PCIE0_AUX>,
+				 <&ccu CLK_PCIE0_AXI_SLV>,
+				 <&ccu CLK_ITS_PCIE0_A>;
+			clock-names = "aux", "slv", "gio";
+			resets = <&ccu RST_BUS_PCIE0>,
+				 <&ccu RST_BUS_PCIE0_PWRUP>,
+				 <&ccu RST_BUS_ITS_PCIE0>;
+			reset-names = "core", "pwr", "gio";
+
+			phys = <&serdes>;
+			phy-names = "pcie";
+			power-domains = <&pck600 PD_PCIE>;
+
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie_intc 0>,
+					<0 0 0 2 &pcie_intc 1>,
+					<0 0 0 3 &pcie_intc 2>,
+					<0 0 0 4 &pcie_intc 3>;
+
+			#interrupt-cells = <1>;
+
+			status = "disabled";
+
+			pcie_intc: legacy-interrupt-controller {
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+			};
+		};
 	};
 
 	thermal-zones {
