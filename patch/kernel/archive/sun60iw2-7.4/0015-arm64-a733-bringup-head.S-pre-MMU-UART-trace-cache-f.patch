From 9cb44f44ee18ab3cc9e7c74239466956102156c5 Mon Sep 17 00:00:00 2001
From: tumredsun <tumredsun@localhost>
Date: Wed, 21 Oct 2026 22:12:18 +0000
Subject: [PATCH 15/39] arm64/a733 bringup: head.S pre-MMU UART trace + cache
 fix; DT memory@40000000 fallback

head.S: dcache_inval_poc -> dcache_clean_poc for init_pg_dir/reserved/init_idmap (PMU fix, cf. jonas5 opi4pro-7.1.5); dsb+isb before and after set_sctlr_el1; pre-MMU UART debug puts (0x02500000, A/B/B1/B2/B4/M1). dts: add /memory@40000000 fallback node (workaround for zero-RAM boot until completion_id_init_idmap is reliable).
---
 .../allwinner/sun60i-a733-orangepi-4-pro.dts  |  9 +++++
 arch/arm64/kernel/head.S                      | 37 +++++++++++++++++--
 arch/arm64/kernel/setup.c                     |  9 +++--
 init/main.c                                   |  2 +
 4 files changed, 50 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts
index 745bbdbc7..1a0371d58 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-4-pro.dts
@@ -10,6 +10,15 @@ / {
 	model = "OrangePi 4 Pro";
 	compatible = "xunlong,orangepi-4-pro", "allwinner,sun60i-a733";
 
+	/* 6 GiB DRAM: U-Boot's bi_dram[0].size fixup is broken at zero on
+	 * this vendor U-Boot (jonas5/orangepi-4pro-armbian boot.md), so keep
+	 * a correct /memory node as the base truth and re-assert it at boot
+	 * time via `fdt set /memory@40000000 reg ...`. */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x1 0x80000000>;
+	};
+
 	aliases {
 		serial0 = &uart0;
 		mmc0 = &mmc0;
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index d6ba3c0af..9700a8e3e 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -82,7 +82,14 @@
 	 *  x20        primary_entry() .. __primary_switch()    CPU boot mode
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
+	.macro uart_putc, ch
+	movz	x22, #0x0250, lsl #16
+	mov	w23, #\ch
+	str	w23, [x22]
+	.endm
+
 SYM_CODE_START(primary_entry)
+	uart_putc 'A'					// A733 debug: entered head.S
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
@@ -95,14 +102,16 @@ SYM_CODE_START(primary_entry)
 
 	/*
 	 * If the page tables have been populated with non-cacheable
-	 * accesses (MMU disabled), invalidate those tables again to
-	 * remove any speculatively loaded cache lines.
+	 * accesses (MMU disabled), clean those tables to the PoC.
+	 * Allwinner A733: dcache_inval_poc discards dirty lines holding
+	 * the freshly built tables, defeating the initial page walk,
+	 * so the tables must be written back instead.
 	 */
 	cbnz	x19, 0f
 	dmb     sy
 	mov	x1, x0				// end of used region
 	adrp    x0, __pi_init_idmap_pg_dir
-	adr_l	x2, dcache_inval_poc
+	adr_l	x2, dcache_clean_poc
 	blr	x2
 	b	1f
 
@@ -119,6 +128,7 @@ SYM_CODE_START(primary_entry)
 1:	mov	x0, x19
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
+	uart_putc 'B'					// A733 debug: boot mode determined
 
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
@@ -126,7 +136,11 @@ SYM_CODE_START(primary_entry)
 	 * On return, the CPU will be ready for the MMU to be turned on and
 	 * the TCR will have been set.
 	 */
+	uart_putc 'B'
+	uart_putc '1'					// A733 debug: cpu_setup pre
 	bl	__cpu_setup			// initialise processor
+	uart_putc 'B'
+	uart_putc '2'					// A733 debug: cpu_setup post
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
@@ -466,6 +480,10 @@ SYM_FUNC_START(__enable_mmu)
 	msr	ttbr0_el1, x2			// load TTBR0
 	load_ttbr1 x1, x1, x3
 
+	uart_putc 'M'
+	uart_putc '1'					// A733 debug: ttbr1 loaded
+	dsb	sy
+	isb
 	set_sctlr_el1	x0
 
 	ret
@@ -505,6 +523,19 @@ SYM_FUNC_START_LOCAL(__no_granule_support)
 SYM_FUNC_END(__no_granule_support)
 
 SYM_FUNC_START_LOCAL(__primary_switch)
+	uart_putc 'B'
+	uart_putc '4'					// A733 debug: enabling MMU
+
+	adrp	x0, __pi_init_idmap_pg_dir
+	adr_l	x1, __pi_init_idmap_pg_end
+	adr_l	x2, dcache_clean_poc
+	blr	x2
+
+	adrp	x0, reserved_pg_dir
+	adr_l	x1, swapper_pg_dir
+	adr_l	x2, dcache_clean_poc
+	blr	x2
+
 	adrp	x1, reserved_pg_dir
 	adrp	x2, __pi_init_idmap_pg_dir
 	bl	__enable_mmu
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index a707deba6..e8d3f8f67 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -36,6 +36,7 @@
 
 #include <asm/acpi.h>
 #include <asm/fixmap.h>
+
 #include <asm/cpu.h>
 #include <asm/cputype.h>
 #include <asm/daifflags.h>
@@ -280,7 +281,7 @@ u64 cpu_logical_map(unsigned int cpu)
 
 void __init __no_sanitize_address setup_arch(char **cmdline_p)
 {
-	setup_initial_init_mm(_text, _etext, _edata, _end);
+		setup_initial_init_mm(_text, _etext, _edata, _end);
 
 	*cmdline_p = boot_command_line;
 
@@ -290,14 +291,14 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	early_ioremap_init();
 
 	setup_machine_fdt(__fdt_pointer);
-
+	
 	/*
 	 * Initialise the static keys early as they may be enabled by the
 	 * cpufeature code and early parameters.
 	 */
 	jump_label_init();
 	parse_early_param();
-
+	
 	dynamic_scs_init();
 
 	/*
@@ -373,7 +374,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 			"This indicates a broken bootloader or old kernel\n",
 			boot_args[1], boot_args[2], boot_args[3]);
 	}
-}
+	}
 
 static inline bool cpu_can_disable(unsigned int cpu)
 {
diff --git a/init/main.c b/init/main.c
index 7b0c8c34e..8a5c818a6 100644
--- a/init/main.c
+++ b/init/main.c
@@ -41,6 +41,7 @@
 #include <linux/kernel_stat.h>
 #include <linux/start_kernel.h>
 #include <linux/security.h>
+
 #include <linux/smp.h>
 #include <linux/profile.h>
 #include <linux/kfence.h>
@@ -1046,6 +1047,7 @@ void start_kernel(void)
 	char *command_line;
 	char *after_dashes;
 
+	
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
 	debug_objects_early_init();
