Subject: [PATCH 07/28] dt-bindings: sunxi: add A733 SerDes and PCIe host
 bindings

---
 .../pci/allwinner,sun60i-a733-pcie.yaml       | 161 ++++++++++++++++++
 .../phy/allwinner,sun60i-a733-serdes.yaml     |  90 ++++++++++
 2 files changed, 251 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-serdes.yaml

diff --git a/Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml b/Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml
new file mode 100644
index 000000000..1ed56150d
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml
@@ -0,0 +1,161 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/allwinner,sun60i-a733-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 PCI Express Host Controller
+
+maintainers:
+  - tumredsun <tumredsun@localhost>
+
+description: >
+  The Allwinner A733 SoC PCIe host controller is based on the Synopsys
+  DesignWare PCIe IP.  In addition to the DBI block, the controller has a
+  dedicated "app" register block carrying the LTSSM control register and
+  the legacy INTx interrupt status registers, plus a dedicated MSI
+  controller interrupting the GIC ITS block.
+
+allOf:
+  - $ref: /schemas/pci/snps,dw-pcie.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-pcie
+
+  interrupts:
+    items:
+      - description: Combined legacy INTx interrupt (SII)
+      - description: MSI interrupt
+
+  interrupt-names:
+    items:
+      - const: legacy
+      - const: msi
+
+  clocks:
+    items:
+      - description: Auxiliary clock
+      - description: DWC PCIe application AXI-bus slave interface clock
+      - description: GIC-ITS (MSI) interface clock
+
+  clock-names:
+    items:
+      - const: aux
+      - const: slv
+      - const: gio
+
+  resets:
+    items:
+      - description: Controller primary (core) reset
+      - description: Controller powerup (cold) reset
+      - description: GIC-ITS (MSI) interface reset
+
+  reset-names:
+    items:
+      - const: core
+      - const: pwr
+      - const: gio
+
+  phys:
+    maxItems: 1
+
+  phy-names:
+    const: pcie
+
+  power-domains:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      PERST# reset signal, from a GPIO.  The pin should be flagged as
+      active-low, since the reset signal is asserted by pulling it low.
+
+  wake-gpios:
+    maxItems: 1
+
+  vpcie3v3-supply:
+    description: A phandle for the 3.3V regulator to use for PCIe
+
+  vpcie1v8-supply:
+    description: A phandle for the 1.8V regulator to use for PCIe
+
+patternProperties:
+  '^legacy-interrupt-controller$':
+    type: object
+    description: >
+      Interrupt controller node for handling legacy PCIe interrupts.
+    properties:
+      interrupt-controller: true
+
+      '#address-cells':
+        const: 0
+
+      '#interrupt-cells':
+        const: 1
+
+    required:
+      - interrupt-controller
+      - '#address-cells'
+      - '#interrupt-cells'
+
+    unevaluatedProperties: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun60i-a733-ccu.h>
+    #include <dt-bindings/reset/sun60i-a733-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    pcie@6000000 {
+        device_type = "pci";
+        compatible = "allwinner,sun60i-a733-pcie";
+        reg = <0x6000000 0x480000>,
+              <0x20000000 0x1000000>;
+        reg-names = "dbi", "config";
+        #address-cells = <3>;
+        #size-cells = <2>;
+        bus-range = <0x0 0xff>;
+        ranges = <0x01000000 0x0 0x21000000 0x21000000 0x0 0x1000000>,
+                 <0x02000000 0x0 0x22000000 0x22000000 0x0 0x6000000>;
+        num-lanes = <1>;
+        max-link-speed = <3>;
+        num-ib-windows = <16>;
+        num-ob-windows = <16>;
+
+        interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "legacy", "msi";
+
+        clocks = <&ccu CLK_PCIE0_AUX>,
+                 <&ccu CLK_PCIE0_AXI_SLV>,
+                 <&ccu CLK_ITS_PCIE0_A>;
+        clock-names = "aux", "slv", "gio";
+        resets = <&ccu RST_BUS_PCIE0>,
+                 <&ccu RST_BUS_PCIE0_PWRUP>,
+                 <&ccu RST_BUS_ITS_PCIE0>;
+        reset-names = "core", "pwr", "gio";
+
+        phys = <&serdes>;
+        phy-names = "pcie";
+        power-domains = <&pck600 PD_PCIE>;
+
+        vpcie3v3-supply = <&reg_pcie3v3>;
+        reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>;
+        wake-gpios = <&pio 3 21 GPIO_ACTIVE_HIGH>;
+        #interrupt-cells = <1>;
+        interrupt-map-mask = <0 0 0 7>;
+        interrupt-map = <0 0 0 1 &pcie_intc 0>,
+                        <0 0 0 2 &pcie_intc 1>,
+                        <0 0 0 3 &pcie_intc 2>,
+                        <0 0 0 4 &pcie_intc 3>;
+
+        pcie_intc: legacy-interrupt-controller {
+            interrupt-controller;
+            #address-cells = <0>;
+            #interrupt-cells = <1>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-serdes.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-serdes.yaml
new file mode 100644
index 000000000..dce7838ab
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-serdes.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun60i-a733-serdes.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 SerDes combo PHY
+
+maintainers:
+  - tumredsun <tumredsun@localhost>
+
+description: >
+  The A733 has a bistable SerDes whose two lanes share the Cadence IP.
+  Each lane combines a USB 3.x, DisplayPort, or PCIe function mapped by
+  the phy-type muxing register in the top-level combo PHY block.  This
+  driver handles the SerDes clocking, reset and power domain setup.
+  Lane 0 supports the DisplayPort and USB functions; lane 1 is used for
+  PCIe function.  The driver configures lane 1 as a PCIe 3.0 PHY.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-serdes
+
+  reg:
+    items:
+      - description: Top-level subsystem register block
+      - description: Top-level combo PHY register block
+      - description: Lane-1 (combo 1) top register block
+      - description: Lane-1 (combo 1) PHY register block
+    maxItems: 4
+
+  clocks:
+    items:
+      - description: SerDes PHY configure clock
+      - description: Reference clock output, 100 MHz
+
+  clock-names:
+    items:
+      - const: serdes-clk
+      - const: dcxo-serdes1-clk
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: serdes-reset
+
+  serdes1v8-supply:
+    description: Phandle to the SerDes analog part 1.8V supply
+
+  ext-refclk:
+    $ref: /schemas/types.yaml#/definitions/flag
+    description:
+      Use the external reference clock input on the SerDes lane 1,
+      instead of selecting the internal one, in case the board
+      provides an external clock source to the PHY.
+
+  '#phy-cells':
+    const: 0
+
+additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#phy-cells'
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun60i-a733-ccu.h>
+    #include <dt-bindings/reset/sun60i-a733-ccu.h>
+
+    soc {
+        serdes: phy@6c00000 {
+            compatible = "allwinner,sun60i-a733-serdes";
+            reg = <0x6c00000 0x400>,
+                  <0x6c06000 0x2000>,
+                  <0x6c02000 0xa00>,
+                  <0x6ca0000 0x20000>;
+            clocks = <&ccu CLK_SERDES_PHY_CFG>,
+                     <&rtc CLK_HOSC_SERDES1>;
+            clock-names = "serdes-clk", "dcxo-serdes1-clk";
+            resets = <&ccu RST_BUS_SERDES>;
+            reset-names = "serdes-reset";
+            serdes1v8-supply = <&reg_cldo5>;
+            #phy-cells = <0>;
+        };
+    };
