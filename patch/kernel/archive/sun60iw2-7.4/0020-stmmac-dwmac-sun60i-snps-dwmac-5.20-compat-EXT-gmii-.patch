diff --git a/include/linux/a733-snap.h b/include/linux/a733-snap.h
new file mode 100644
index 000000000..17e0103c4
--- /dev/null
+++ b/include/linux/a733-snap.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * A733 bring-up debug: read-only snapshot of the PCIe datapath.
+ * cfg/io/mem are the CPU windows the bootloader left alive; lnksta/sii/lcv
+ * come from the controller; the trailing columns sample CCU gates.
+ */
+
+#ifndef _LINUX_A733_SNAP_H
+#define _LINUX_A733_SNAP_H
+
+#include <linux/io.h>
+#include <linux/err.h>
+#include <linux/kernel.h>
+
+void clk_pcie_watch(const char *cmd, const char *name);
+
+/* dbg #74: silent snap - no UART output, lines go to a rotating buffer */
+#define A733_SNAP_LOG_N 64
+extern char a733_snap_log[A733_SNAP_LOG_N][192];
+extern int a733_snap_log_idx;
+
+static inline void a733_snap_dump(void)
+{
+	int i;
+
+	for (i = 0; i < A733_SNAP_LOG_N && i <= a733_snap_log_idx; i++)
+		pr_emerg("%s\n", a733_snap_log[i]);
+}
+
+static inline void a733_pcie_snap(const char *tag)
+{
+	/* dbg #73: cache the mappings - 6x ioremap/iounmap per snap was
+	 * churn inside the death window */
+	static void __iomem *dbi, *app, *cfg, *ioa, *mem, *ccu;
+
+	if (!dbi) {
+		dbi = ioremap(0x6000000, 0x200);
+		app = ioremap(0x6400000, 0x2000);
+		cfg = ioremap(0x20000000, 0x1000);
+		ioa = ioremap(0x21000000, 0x1000);
+		mem = ioremap(0x22000000, 0x1000);
+		ccu = ioremap(0x2002000, 0x3000);
+	}
+
+	if (a733_snap_log_idx < A733_SNAP_LOG_N)
+		a733_snap_log_idx++;
+
+	snprintf(a733_snap_log[a733_snap_log_idx % A733_SNAP_LOG_N],
+		 sizeof(a733_snap_log[0]),
+		 "a733-snap[%s]: cfg=%08x io=%08x mem=%08x lnksta=%04x sii=%08x lcv=%08x aux=%08x slv=%08x rst=%08x sfc=%08x gb=%08x gm=%08x",
+		 tag,
+		 cfg ? readl(cfg) : 0,
+		 ioa ? readl(ioa) : 0,
+		 mem ? readl(mem) : 0,
+		 dbi ? readw(dbi + 0x8a) : 0,
+		 app ? readl(app + 0xe0c) : 0,
+		 dbi ? readl(dbi + 0x80c) : 0,
+		 ccu ? readl(ccu + 0x1380) : 0,
+		 ccu ? readl(ccu + 0x1384) : 0,
+		 ccu ? readl(ccu + 0x138c) : 0,
+		 ccu ? readl(ccu + 0x13c0) : 0,
+		 ccu ? readl(ccu + 0x5c0) : 0,
+		 ccu ? readl(ccu + 0x5e0) : 0);
+}
+
+#endif
