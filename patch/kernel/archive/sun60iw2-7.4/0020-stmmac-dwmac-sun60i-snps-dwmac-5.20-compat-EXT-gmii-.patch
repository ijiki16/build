diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index f531f383b..bbfe6aac1 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -84,7 +84,12 @@
 	 */
 	.macro uart_putc, ch
 	movz	x16, #0x0250, lsl #16
-	mov	w17, #\ch
+	mov	w15, #0x8000
+1:	ldr	w17, [x16, #0x14]
+	tbnz	w17, #5, 2f
+	subs	w15, w15, #1
+	b.ne	1b
+2:	mov	w17, #\ch
 	str	w17, [x16]
 	.endm
 
@@ -486,13 +491,17 @@ SYM_FUNC_START(__enable_mmu)
 	msr	ttbr0_el1, x2			// load TTBR0
 	load_ttbr1 x1, x1, x3
 
+	/*
+	 * A733 debug: M1 is safe here (MMU still off, UART is written via its
+	 * physical address). Do NOT emit a marker after set_sctlr_el1: secondary
+	 * CPUs then run on idmap_pg_dir, which does not map the UART, so the
+	 * store would fault before VBAR is set and the CPU would silently die.
+	 */
 	uart_putc 'M'
 	uart_putc '1'					// A733 debug: ttbr1 loaded
 	dsb	sy
 	isb
 	set_sctlr_el1	x0
-	uart_putc 'M'
-	uart_putc '2'					// A733 debug: mmu on
 
 	ret
 SYM_FUNC_END(__enable_mmu)
diff --git a/arch/arm64/kernel/pi/map_kernel.c b/arch/arm64/kernel/pi/map_kernel.c
index ba539c110..3550cf818 100644
--- a/arch/arm64/kernel/pi/map_kernel.c
+++ b/arch/arm64/kernel/pi/map_kernel.c
@@ -26,6 +26,10 @@ extern void idmap_cpu_replace_ttbr1(phys_addr_t pgdir);
  */
 static noinline void __init pi_putc(char c)
 {
+	int n = 100000;
+
+	while (n-- && !(*(volatile u32 *)0x02500014 & 0x20))
+		cpu_relax();
 	*(volatile u32 *)0x02500000 = (u32)c;
 }
 
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 1f9ae3d6c..943e9927c 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -28,6 +28,7 @@
 #include <linux/proc_fs.h>
 #include <linux/memblock.h>
 #include <linux/of_fdt.h>
+#include <linux/libfdt.h>
 #include <linux/efi.h>
 #include <linux/psci.h>
 #include <linux/sched/task.h>
@@ -282,13 +283,50 @@ u64 cpu_logical_map(unsigned int cpu)
 /* A733 debug: direct UART0 trace while the idmap is still installed */
 static noinline void __init a733_putc(char c)
 {
+	int n = 100000;
+
+	while (n-- && !(*(volatile u32 *)0x02500014 & 0x20))
+		cpu_relax();
 	*(volatile u32 *)0x02500000 = (u32)c;
 }
 
 /* A733 debug: same UART through the permanent fixmap (survives idmap removal) */
 static noinline void __init a733_fix_putc(char c)
 {
-	*(volatile u32 *)__fix_to_virt(FIX_EARLYCON_MEM_BASE) = (u32)c;
+	volatile u32 *base = (volatile u32 *)__fix_to_virt(FIX_EARLYCON_MEM_BASE);
+	int n = 100000;
+
+	while (n-- && !(base[5] & 0x20))
+		cpu_relax();
+	base[0] = (u32)c;
+}
+
+static noinline void __init a733_hex(u64 v)
+{
+	int i;
+
+	for (i = 60; i >= 0; i -= 4) {
+		unsigned int d = (v >> i) & 0xf;
+
+		a733_fix_putc(d < 10 ? '0' + d : 'a' + d - 10);
+	}
+}
+
+static noinline void __init a733_div_dump(char tag)
+{
+	volatile u32 *u = (volatile u32 *)__fix_to_virt(FIX_EARLYCON_MEM_BASE);
+	u32 lcr, dll, dlm;
+
+	lcr = u[3];
+	u[3] = lcr | 0x80;
+	dll = u[0];
+	dlm = u[1];
+	u[3] = lcr;
+
+	a733_fix_putc(tag);
+	a733_fix_putc(':');
+	a733_hex(((u64)dlm << 16) | dll);
+	a733_fix_putc(';');
 }
 
 void __init __no_sanitize_address setup_arch(char **cmdline_p)
@@ -306,6 +344,33 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	setup_machine_fdt(__fdt_pointer);
 	a733_fix_putc('S'); a733_fix_putc('3');
+	a733_fix_putc('F'); a733_hex((u64)__fdt_pointer);
+	a733_fix_putc('/'); a733_hex((u64)fdt_totalsize(initial_boot_params));
+	a733_fix_putc(';');
+	{
+		const u32 *h = (const u32 *)initial_boot_params;
+		unsigned int off = fdt_off_dt_struct(initial_boot_params) / 4;
+		int i;
+
+		a733_fix_putc('H');
+		for (i = 0; i < 6; i++) {
+			a733_fix_putc(':'); a733_hex(h[i]);
+		}
+		a733_fix_putc(']');
+		for (i = 0; i < 8; i++) {
+			a733_fix_putc(':'); a733_hex(h[off + i]);
+		}
+		a733_fix_putc(';');
+	}
+	{
+		const char *m = of_flat_dt_get_machine_name();
+		int i;
+
+		a733_fix_putc('G'); a733_fix_putc(':');
+		for (i = 0; m && i < 40 && m[i]; i++)
+			a733_fix_putc(m[i]);
+		a733_fix_putc(';');
+	}
 	{
 		const char *p = boot_command_line;
 		int i;
@@ -314,7 +379,30 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 		for (i = 0; i < 100 && p[i]; i++)
 			a733_fix_putc(p[i]);
 		a733_fix_putc('|');
+		a733_fix_putc('M'); a733_hex(memblock_phys_mem_size());
+		a733_fix_putc(','); a733_hex((u64)memblock.memory.cnt);
+		a733_fix_putc(';');
+	}
+	a733_div_dump('D');
+
+	/*
+	 * A733 debug: this vendor U-Boot hands the kernel a damaged FDT
+	 * (no bootargs, /memory zeroed), so provide both from the kernel.
+	 */
+	if (!boot_command_line[0]) {
+		strscpy(boot_command_line,
+			"root=PARTUUID=527e29fa-1a14-4ec4-a4de-df61c015c083 rootwait rootfstype=ext4 earlycon=uart8250,mmio32,0x02500000 nokaslr console=ttyS0,115200 console=tty1 consoleblank=0 loglevel=7 clk_ignore_unused swiotlb=65536 cma=512M",
+			COMMAND_LINE_SIZE);
+		a733_fix_putc('K'); a733_fix_putc('1');
+	}
+	if (memblock_phys_mem_size() == 0) {
+		memblock_add(0x40000000, 0x180000000);
+		a733_fix_putc('R'); a733_fix_putc('1');
 	}
+	a733_fix_putc('R'); a733_fix_putc('2');
+	a733_hex(memblock_phys_mem_size());
+	a733_fix_putc(','); a733_hex((u64)memblock.memory.cnt);
+	a733_fix_putc(';');
 
 	/*
 	 * Initialise the static keys early as they may be enabled by the
@@ -323,6 +411,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	jump_label_init();
 	parse_early_param();
 	a733_fix_putc('S'); a733_fix_putc('4');
+	a733_div_dump('E');
 	
 	dynamic_scs_init();
 
@@ -348,7 +437,9 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	a733_fix_putc('U'); a733_fix_putc('0');
 
 	xen_early_init();
+	a733_fix_putc('V'); a733_fix_putc('0');
 	efi_init();
+	a733_fix_putc('V'); a733_fix_putc('1');
 
 	if (!efi_enabled(EFI_BOOT)) {
 		if ((u64)_text % MIN_KIMG_ALIGN)
@@ -356,8 +447,14 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 		WARN_TAINT(mmu_enabled_at_boot, TAINT_FIRMWARE_WORKAROUND,
 			   FW_BUG "Booted with MMU enabled!");
 	}
+	a733_fix_putc('W'); a733_fix_putc('0');
 
 	arm64_memblock_init();
+	a733_fix_putc('V'); a733_fix_putc('2');
+	a733_fix_putc('M'); a733_fix_putc('3');
+	a733_hex(memblock_phys_mem_size());
+	a733_fix_putc(','); a733_hex((u64)memblock.memory.cnt);
+	a733_fix_putc(';');
 
 	paging_init();
 	a733_fix_putc('P'); a733_fix_putc('2');
