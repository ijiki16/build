 	if (root_wait)
 		wait_for_root(saved_root_name);
+	a733_mark("h");
 	mount_root(saved_root_name);
+	a733_mark("J4");
 	devtmpfs_mount();
 
 	if (init_pivot_root(".", ".")) {
