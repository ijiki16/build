+/*
+ * A733 liveness poller: watches the PCIe CPU config window at ~2 ms cadence
+ * from the very start and reports the transition moment, the context
+ * (irq/preempt/cpu) and a rapid re-read burst so the timing of the datapath
+ * death is precise.
+ */
+
+static void __iomem *a733_pol_cfg;
+static void __iomem *a733_pol_io;
+static void __iomem *a733_pol_mem;
+static void __iomem *a733_pol_dbi;
+static void __iomem *a733_pol_app;
+
+static int a733_pol_die_count;
+
+static int a733_pol_fn(void *arg)
+{
+	unsigned int last = 0, lc_last = 0, si_last = 0;
+	int first = 1, k;
+
+	a733_pol_cfg = ioremap(0x20000000, 0x1000);
+	a733_pol_io = ioremap(0x21000000, 0x1000);
+	a733_pol_mem = ioremap(0x22000000, 0x1000);
+	a733_pol_dbi = ioremap(0x6000000, 0x200);
+	a733_pol_app = ioremap(0x6400000, 0x2000);
+
+	for (;;) {
+		unsigned int v, lc, si;
+
+		if (kthread_should_stop())
+			break;
+
+		v = readl(a733_pol_cfg);
+		lc = readl(a733_pol_dbi + 0x80c);
+		si = readl(a733_pol_app + 0xe0c);
+
+		if (first) {
+			last = v;
+			lc_last = lc;
+			si_last = si;
+			first = 0;
+			pr_emerg("a733-poll: first cfg=%08x lc=%08x si=%08x\n", v, lc, si);
+		}
+
+		if (v != last) {
+			pr_emerg("a733-pol: cfg %08x -> %08x (cpu=%d)\n",
+				 last, v, smp_processor_id());
+
+			/* dbg #79: task-dump removed - in #77/#78 the kernel
+			 * hung mid-dump at ~3.39 with show_state_filter
+			 * interleaving the snap prints */
+			a733_pol_die_count++;
+
+			a733_pcie_snap("pol");
+
+			for (k = 0; k < 8; k++) {
+				msleep(3);
+				pr_emerg("a733-pol: re[%d] cfg=%08x io=%08x mem=%08x\n", k,
+					 readl(a733_pol_cfg), readl(a733_pol_io),
+					 readl(a733_pol_mem));
+			}
+			last = v;
+		}
+		if (lc != lc_last || si != si_last) {
+			pr_emerg("a733-pol: lc=%08x si=%08x (was %08x %08x)\n",
+				 lc, si, lc_last, si_last);
+			lc_last = lc;
+			si_last = si;
+		}
+
+		usleep_range(150, 350);
+	}
+
+	return 0;
+}
+
+static noinline void __init a733_pol_start(void)
+{
+	struct task_struct *p;
+
+	p = kthread_run(a733_pol_fn, NULL, "a733-pol");
+	if (IS_ERR(p))
+		pr_emerg("a733-poll: start failed %ld\n", PTR_ERR(p));
+	else
+		pr_emerg("a733-poll: started\n");
+}
