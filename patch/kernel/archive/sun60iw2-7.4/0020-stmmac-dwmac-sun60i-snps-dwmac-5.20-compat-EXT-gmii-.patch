+/*
+ * Cold bring-up mirroring the vendor loader (u-boot pcie-sunxi): the
+ * link parameters are programmed while the link training is disabled,
+ * the PERST toggles around the whole configuration, the LTSSM is
+ * enabled afterwards and a directed speed change completes the
+ * training at the internal target rate.
+ */
+static void sun60i_a733_pcie_vendor_init(struct sun60i_a733_pcie *pcie)
 {
 	struct dw_pcie *pci = &pcie->pci;
+	int cap, i;
+	u32 val;
+
+	cap = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
+
+	sun60i_a733_pcie_ltssm_disable(pcie);
+
+	gpiod_set_value_cansleep(pcie->wake_gpio, 1);
+	gpiod_set_value_cansleep(pcie->rst_gpio, 1);
+	msleep(100);
+	gpiod_set_value_cansleep(pcie->rst_gpio, 0);
+	msleep(100);
+
+	dw_pcie_dbi_ro_wr_en(pci);
+
+	/* Target speed and lane count with the link down (set_rate). */
+	val = dw_pcie_readl_dbi(pci, cap + PCI_EXP_LNKCTL2);
+	val |= FIELD_PREP(PCI_EXP_LNKCTL2_TLS, 0x2);
+	dw_pcie_writel_dbi(pci, cap + PCI_EXP_LNKCTL2, val);
+
+	val = dw_pcie_readl_dbi(pci, cap + PCI_EXP_LNKCAP);
+	val |= FIELD_PREP(PCI_EXP_LNKCAP_SLS, 0x3);
+	dw_pcie_writel_dbi(pci, cap + PCI_EXP_LNKCAP, val);
+	dw_pcie_dbi_ro_wr_dis(pci);
+
+	val = dw_pcie_readl_dbi(pci, PCIE_PORT_LINK_CONTROL);
+	val &= ~PORT_LINK_MODE_MASK;
+	val |= PORT_LINK_MODE_1_LANES;
+	dw_pcie_writel_dbi(pci, PCIE_PORT_LINK_CONTROL, val);
+
+	val = dw_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL);
+	val &= ~PORT_LOGIC_LINK_WIDTH_MASK;
+	val |= PORT_LOGIC_LINK_WIDTH_1_LANES;
+	dw_pcie_writel_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL, val);
+
+	/* Root-port configuration while the link is down (setup_rc). */
+	dw_pcie_writel_dbi(pci, PCI_BASE_ADDRESS_0, 0x00000004);
+	dw_pcie_writel_dbi(pci, PCI_BASE_ADDRESS_1, 0x00000000);
+
+	val = dw_pcie_readl_dbi(pci, PCI_INTERRUPT_LINE);
+	val &= 0xffff00ff;
+	val |= 0x00000100;
+	dw_pcie_writel_dbi(pci, PCI_INTERRUPT_LINE, val);
+
+	val = dw_pcie_readl_dbi(pci, PCI_PRIMARY_BUS);
+	val &= 0xff000000;
+	val |= 0x00ff0100;
+	dw_pcie_writel_dbi(pci, PCI_PRIMARY_BUS, val);
+
+	val = dw_pcie_readl_dbi(pci, PCI_COMMAND);
+	val &= 0xffff0000;
+	val |= PCI_COMMAND_IO | PCI_COMMAND_MEMORY |
+	       PCI_COMMAND_MASTER | PCI_COMMAND_SERR;
+	dw_pcie_writel_dbi(pci, PCI_COMMAND, val);
+
+	dw_pcie_writel_dbi(pci, PCI_BASE_ADDRESS_0, 0x00000000);
+
+	dw_pcie_writew_dbi(pci, PCI_CLASS_DEVICE, PCI_CLASS_BRIDGE_PCI);
+
+	val = dw_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL);
+	val |= PORT_LOGIC_SPEED_CHANGE;
+	dw_pcie_writel_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL, val);
+
+	sun60i_a733_pcie_ltssm_enable(pcie);
+
+	for (i = 0; i < 20 && !sun60i_a733_pcie_link_up(pci); i++)
+		msleep(100);
+
+	/* Directed speed change after training. */
+	dw_pcie_dbi_ro_wr_en(pci);
+	val = dw_pcie_readl_dbi(pci, cap + PCI_EXP_LNKCTL2);
+	val |= FIELD_PREP(PCI_EXP_LNKCTL2_TLS, 0x2);
+	dw_pcie_writel_dbi(pci, cap + PCI_EXP_LNKCTL2, val);
+	dw_pcie_dbi_ro_wr_dis(pci);
+
+	val = dw_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL);
+	val &= ~PORT_LOGIC_SPEED_CHANGE;
+	dw_pcie_writel_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL, val);
+	val |= PORT_LOGIC_SPEED_CHANGE;
+	dw_pcie_writel_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL, val);
+
+	for (i = 0; i < 20; i++) {
+		val = dw_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL);
+		if (!(val & PORT_LOGIC_SPEED_CHANGE))
+			break;
+		msleep(1);
+	}
+
+	dev_info(pci->dev, "dbg: vendor bringup link=%d LNKSTA=%04x lwcs=%08x\n",
+		 sun60i_a733_pcie_link_up(pci),
+		 dw_pcie_readw_dbi(pci, cap + PCI_EXP_LNKSTA),
+		 dw_pcie_readl_dbi(pci, PCIE_LINK_WIDTH_SPEED_CONTROL));
+}
