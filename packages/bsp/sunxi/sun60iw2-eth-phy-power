#!/usr/bin/python3 -I
# Orange Pi 4 Pro (sun60iw2), mainline kernel: switch on the YT8531C PHY supply
# (VCC-3V3-PHY = AXP PMIC dc1sw1, reg 0x11 bit 3 at I2C 0x36 on the
# S-TWI0 bus i2c@7083000), then re-probe the GMAC so it finds the PHY.
# Stopgap until mainline has a driver for this PMIC.
import fcntl, glob, os, sys, time

I2C_SLAVE_FORCE = 0x0706
PMIC, REG, BIT = 0x36, 0x11, 0x08
GMAC = "4500000.ethernet"
DRV = "/sys/bus/platform/drivers/dwmac-sun60i"

bus = [p for p in glob.glob("/sys/bus/i2c/devices/i2c-*")
       if "7083000" in os.path.realpath(p)]
if not bus:
    sys.exit("sun60iw2-eth-phy-power: PMIC i2c bus (7083000) not found")
fd = os.open("/dev/" + os.path.basename(bus[0]), os.O_RDWR)
fcntl.ioctl(fd, I2C_SLAVE_FORCE, PMIC)
os.write(fd, bytes([REG]))
val = os.read(fd, 1)[0]
if val & BIT:
    print("sun60iw2-eth-phy-power: dc1sw1 already on (0x%02x)" % val)
    sys.exit(0)
os.write(fd, bytes([REG, val | BIT]))
time.sleep(0.3)  # rail ramp + PHY power-on reset
os.write(fd, bytes([REG]))
print("sun60iw2-eth-phy-power: dc1sw1 on, reg 0x11 0x%02x -> 0x%02x"
      % (val, os.read(fd, 1)[0]))

if os.path.exists(os.path.join(DRV, GMAC)):
    open(os.path.join(DRV, "unbind"), "w").write(GMAC)
open(os.path.join(DRV, "bind"), "w").write(GMAC)
