#!/usr/bin/python3 -I
"""Attach the AIC8800D80 Bluetooth controller on ttyS1, retrying until BlueZ can use it.

The controller sometimes never answers the first long HCI command and keeps waiting for
its missing bytes. Sending HCI resets fills that command and returns it to a known state.
"""
import os
import select
import subprocess
import sys
import termios
import time

PORT = "/dev/ttyS1"
ATTEMPTS = 6
READY_SECONDS = 12
HCI_RESET = bytes([0x01, 0x03, 0x0c, 0x00])
RESET_DONE = bytes([0x0e, 0x04])


def read_for(fd, seconds):
    data = b""
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if select.select([fd], [], [], 0.05)[0]:
            data += os.read(fd, 512)
    return data


def flush_controller():
    fd = os.open(PORT, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        attrs = termios.tcgetattr(fd)
        attrs[0] = attrs[1] = attrs[3] = 0
        attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
        attrs[4] = attrs[5] = termios.B1500000
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        read_for(fd, 0.3)
        for _ in range(80):  # enough bytes to complete the longest HCI command
            os.write(fd, HCI_RESET)
            if RESET_DONE in read_for(fd, 0.03):
                break
        read_for(fd, 0.5)
    finally:
        os.close(fd)


def controller_ready():
    # btmgmt exits without an answer when its stdin closes at once.
    result = subprocess.run(["sh", "-c", "sleep 1 | btmgmt info"], capture_output=True, text=True,
                            timeout=5, check=False)
    return any(line.startswith("hci0") for line in result.stdout.splitlines())


def main():
    for attempt in range(1, ATTEMPTS + 1):
        flush_controller()
        attach = subprocess.Popen(["btattach", "-B", PORT, "-P", "h4", "-S", "1500000"],
                                  stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL)
        end = time.monotonic() + READY_SECONDS
        while time.monotonic() < end and attach.poll() is None:
            time.sleep(1)
            try:
                if controller_ready():
                    print(f"controller ready on attempt {attempt}")
                    return 0
            except subprocess.TimeoutExpired:
                pass
        attach.terminate()
        attach.wait()
        time.sleep(1)
    print("controller did not start", file=sys.stderr)
    return 1


sys.exit(main())
